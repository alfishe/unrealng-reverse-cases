    {
      "offset": 0,
      "name": "CountBases",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Count each side's bases: warbases and the factories of each type"
    },
    {
      "offset": 55,
      "name": "CountRobots",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "PlayerRobots ($FD41) and EnemyRobots ($FD49): the live records of each side"
    },
    {
      "offset": 71,
      "name": "CountLiveRobots",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = the live records among 24 robot records from HL (+1 not 0); HL moves past them"
    },
    {
      "offset": 88,
      "name": "GiveFactory",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Factory A (0-23) changes hands: to the player (B = 0) or the enemy (B = 1); its flag moves"
    },
    {
      "offset": 125,
      "name": "GiveWarbase",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Warbase A (0-3) changes hands: to the player (B = 0) or the enemy (B = 1)"
    },
    {
      "offset": 176,
      "name": "SetBaseOwner",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Base record A (HL = the table's +3 bytes): owner = the player (B = 0) or the enemy; HL = its door cell"
    },
    {
      "offset": 207,
      "name": "DestroyFactory",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Factory A (0-23) destroyed by a nuclear blast: buildings removed, blocks turned to debris"
    },
    {
      "offset": 240,
      "name": "DestroyWarbase",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Warbase A (0-3) destroyed by a nuclear blast: buildings removed, blocks turned to debris"
    },
    {
      "offset": 275,
      "name": "MarkBaseDestroyed",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Base A of the table HL (+3 bytes): +3 = $80 (destroyed, no owner); HL = its door cell"
    },
    {
      "offset": 314,
      "name": "AddBuilding",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Add a building: map cell HL, type C (0 pad, 1-6 factory, 7 the player's flag, 8 the enemy's flag)"
    },
    {
      "offset": 340,
      "name": "RemoveBuilding",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Remove the building on map cell HL, if any: its record freed, bit 6 of the cell cleared"
    },
    {
      "offset": 358,
      "name": "BuildMap",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A new game's map: clear it, place the scenery and the 28 bases, give the warbases their owners"
    },
    {
      "offset": 461,
      "name": "PlaceScenery",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Place a scenery list at HL (3-byte records: tile or shape, x low, y; 0 ends), D = x high byte"
    },
    {
      "offset": 496,
      "name": "PlaceBases",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Place a bases list at HL (3-byte records: type, x low, y; $FF ends), D = x high byte"
    },
    {
      "offset": 600,
      "name": "DrawShape",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw shape A (bit 7 ignored, the index into ShapeTable) from map cell HL"
    },
    {
      "offset": 630,
      "name": "StepCell",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL += C columns (signed) and B rows (signed: H += 2 * B); DE kept"
    },
    {
      "offset": 648,
      "name": "PutBlock",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A 2 x 2 block of tile A with its bottom left at map cell HL"
    }
