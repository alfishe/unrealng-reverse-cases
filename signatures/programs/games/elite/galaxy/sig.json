  "entries": [
    {
      "offset": 74,
      "name": "NextGalaxy",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen 16 of ScreenTable, which nothing asks for: the galaxy number one more (wrapping at 8) and the galaxy's seeds twisted (unreachable; GalaxyJump does the same in the game)"
    },
    {
      "offset": 97,
      "name": "TwistWord",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The two bytes at HL rotated left one bit each"
    },
    {
      "offset": 107,
      "name": "FindSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The system named in NameInput: walk the galaxy's 256 systems comparing NameBuffer; carry when none"
    },
    {
      "offset": 167,
      "name": "FindNearest",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The system nearest the chart cursor becomes the selected one, with the cross redrawn on the charts"
    },
    {
      "offset": 187,
      "name": "FindNearestNow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Walk the 256 systems for the smallest dx^2 + (dy/2)^2 to the cursor ($D0BB, $D0BC), then its data, name and distance"
    },
    {
      "offset": 267,
      "name": "NextSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Four twists: the next system's seeds"
    },
    {
      "offset": 277,
      "name": "SquaredDistance",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = (the cursor's x - B)^2 + ((the cursor's y - A) / 2)^2, B and A the system's x and y"
    },
    {
      "offset": 305,
      "name": "AbsDifference",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = |A - B|"
    },
    {
      "offset": 313,
      "name": "JumpDistance",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "JumpRange = 4 x the root of HL ($FFFF on a carry)"
    },
    {
      "offset": 336,
      "name": "MultiplyDA",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = D x A (shift and add, eight steps)"
    },
    {
      "offset": 355,
      "name": "SystemName",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The name of the system in SystemSeeds into NameBuffer: four pairs when bit 6 of s0's low byte is set, else three"
    },
    {
      "offset": 388,
      "name": "NamePair",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One pair: s2's high byte AND $1F picks StdPairs entry (0: none), a \"?\" second letter left out; then a twist"
    },
    {
      "offset": 426,
      "name": "Twist",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "s0, s1, s2 = s1, s2, s0 + s1 + s2"
    },
    {
      "offset": 455,
      "name": "KeepName",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "NameBuffer becomes SelectedName"
    },
    {
      "offset": 467,
      "name": "SystemData",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The selected system from SystemSeeds: its seeds, the cursor on it, the economy, government, tech level, population and productivity"
    },
    {
      "offset": 590,
      "name": "PrintDistance",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "DISTANCE: and the jump range with its point and LIGHT YEARS, then a new line (nothing at 0)"
    },
    {
      "offset": 621,
      "name": "GalaxySeeds",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "SystemSeeds = the galaxy's seeds: the walk starts at its first system"
    },
    {
      "offset": 629,
      "name": "SaveSeeds",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "BestSeeds = SystemSeeds"
    },
    {
      "offset": 637,
      "name": "RestoreSeeds",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "SystemSeeds = BestSeeds"
    },
    {
      "offset": 643,
      "name": "CopySeeds",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Six bytes from HL to DE"
    },
    {
      "offset": 649,
      "name": "NewMarket",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A new fluctuation byte ($D06A) from StarSeed, then MakeMarket"
    },
    {
      "offset": 655,
      "name": "MakeMarket",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Each commodity's price ($E1BD) and the station's stock ($D09E) from Commodities, the economy and the fluctuation"
    }
  ],
