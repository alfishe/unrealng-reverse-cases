    },
    {
      "offset": 684,
      "name": "FarPart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "NZ when a part (HL, doubled) is $40 or more: not yet at the target"
    },
    {
      "offset": 692,
      "name": "RelativePart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One part of (target - missile) / 2, through SubtractSigned $AFC9"
    },
    {
      "offset": 733,
      "name": "AwayPart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One part of the ship's position, its sign flipped: the vector away from the player, halved"
    },
    {
      "offset": 740,
      "name": "TowardsPart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One part of the ship's position, halved, its sign in bit 7: the vector to steer along"
    },
    {
      "offset": 764,
      "name": "TacticsAim",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Normalise the target vector, the dot products with the nose, the roof and the side: the roll, the pitch, the speed, the laser"
    },
    {
      "offset": 1042,
      "name": "MultiplyHigh4",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL: H = the sign, A = -4 x A x B / 256 (the high bytes of two parts)"
    },
    {
      "offset": 1057,
      "name": "DotProduct",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = the dot product of the axis at IX and the target vector at IY from their high bytes, sign in bit 7"
    }
