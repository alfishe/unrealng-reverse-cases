  "entries": [
    {
      "offset": 0,
      "name": "JumpKeys",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "H or G+H (KeyViews $FC0A bits 4, 5): a jump, unless one counts down; docked: DOCKED and the status screen"
    },
    {
      "offset": 135,
      "name": "JumpTick",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Each MessageTick: the countdown (shown halved, two digits at 1,1), and at 0 the jump itself"
    },
    {
      "offset": 172,
      "name": "GalaxyJump",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The next galaxy: the missions reset (the nova over, the Thargoids forgotten), the hyperdrive used up, the seeds twisted, the legal status clean, the system nearest the cursor"
    },
    {
      "offset": 225,
      "name": "TwistSeed",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The two bytes at HL rotated left one bit each, HL two on"
    },
    {
      "offset": 286,
      "name": "JumpWitch",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The misjump: WitchSpace on, the current system half way to the selected one, no safe zone, no system names"
    },
    {
      "offset": 327,
      "name": "JumpArrive",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The arrival: the selected system becomes the current one; the sun, the planet and the station from its seeds; the market"
    },
    {
      "offset": 603,
      "name": "MissionTriggers",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Outside galaxy 1: the Thargoid mission's stage, the jump count, the three triggers, the pirate station's chance"
    },
    {
      "offset": 663,
      "name": "PirateChance",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The station pirate-held (its roll counter's bit 7 cleared) with a chance by the government"
    },
    {
      "offset": 682,
      "name": "JumpEnd",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The tunnel next (TunnelLoop 1), the front view, the cabin temperature, SunNear, MissileState and MissionShip 0, the altitude $A0"
    },
    {
      "offset": 709,
      "name": "MissionNova",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "32 jumps: the sun goes nova: flag bit 0, NovaMission, the view red, a fuel leak"
    },
    {
      "offset": 732,
      "name": "MissionCloak",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "128 jumps: the cloak ship may come (flag bit 1)"
    },
    {
      "offset": 742,
      "name": "MissionThargoids",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "254 jumps: the Thargoid MAYDAY (flag bit 2, MissionState 1)"
    },
    {
      "offset": 757,
      "name": "FuelLeak",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "All the fuel lost, FUEL LEAK on the message line (slot 9), when there was any"
    },
    {
      "offset": 768,
      "name": "SetFuel",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The fuel = A, at most 70 (7.0 light years); the fuel bar 2.25 x A"
    }
  ],
