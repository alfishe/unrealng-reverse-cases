  "entries": [
    {
      "offset": 8,
      "name": "CommanderMenu",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The ACCESS MENU: 1 load, 2 save, 3 leave; returns A = 1 (NZ) when a commander was loaded"
    },
    {
      "offset": 68,
      "name": "LoadCommander",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "1: the name to look for (empty: the first commander found), then blocks until the names agree"
    },
    {
      "offset": 126,
      "name": "SaveCommander",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "2: the name into the record, the sun's place into its tail, START TAPE, SA-BYTES, then the security number"
    },
    {
      "offset": 170,
      "name": "SecurityNumber",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Print \"SECURITY NUMBER:\" and two five-digit numbers made from the combat score, the galaxy, two mission flags and the cash"
    },
    {
      "offset": 262,
      "name": "KeepCommander",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The record becomes DefaultCommander (93 bytes), back to the menu"
    },
    {
      "offset": 276,
      "name": "Parity",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The parity of A's eight bits into the top of D (C = the count of ones, its bit 0 shifted in)"
    },
    {
      "offset": 291,
      "name": "LoadFailed",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One frame, then BREAK if SPACE is held (FC0D = $20), else TAPE LOADING ERROR and the record back from DefaultCommander"
    },
    {
      "offset": 299,
      "name": "TapeBreak",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The message lines cleared and BREAK"
    },
    {
      "offset": 309,
      "name": "TapeError",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": ""
    },
    {
      "offset": 327,
      "name": "TapeBlock",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "IX = the record, DE = 102, A = $FF (a data block)"
    },
    {
      "offset": 337,
      "name": "ReadName",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Read a name of up to 10 letters into HL after COMMANDER'S NAME? (other 8)"
    },
    {
      "offset": 344,
      "name": "TapeMessage",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Other token A on the message row 22, after the row is cleared; a new line, a click"
    },
    {
      "offset": 376,
      "name": "ViewTexts",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The space view's name (\"FRONT VIEW\" and the like) into the back buffer, then MessageTick"
    },
    {
      "offset": 434,
      "name": "MessageTick",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The jump countdown, the condition light, then the message line: show, scan the slots, or raise a periodic message"
    },
    {
      "offset": 479,
      "name": "MessageShow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Show standard code B at column C for 14 passes"
    },
    {
      "offset": 484,
      "name": "MessageSet",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Code B at column C, the count left as it is"
    },
    {
      "offset": 556,
      "name": "MessagePeriodic",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Every 70 passes: ENERGY LOW, FUEL SCOOPS ON (and the fuel), DOCKING COMPUTERS ON, or the mission's MAYDAY"
    },
    {
      "offset": 655,
      "name": "ClearMessages",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Every slot's request bit cleared and the line's code to 0"
    }
  ],
