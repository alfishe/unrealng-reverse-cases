    {
      "offset": 0,
      "name": "Stardust",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Move and draw the 16 dots for the view; after a J jump, two fast passes first"
    },
    {
      "offset": 25,
      "name": "StardustPass",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One pass: the rates into StarRoll and StarPitch, the speed halved + 1, then every dot"
    },
    {
      "offset": 171,
      "name": "StardustFront",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The front and rear views: a dot moves out by its depth, then by the roll and the pitch"
    },
    {
      "offset": 525,
      "name": "StarRollScale",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = the coordinate in A times the rate in C, 4 bits (MulBits), doubled and rounded"
    },
    {
      "offset": 548,
      "name": "StarRollPitch",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Apply the roll and the pitch to the dot being moved"
    },
    {
      "offset": 709,
      "name": "StarPlot",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Add the dot's back buffer address and mask (StarAddress) to StarList, or respawn it off the screen"
    },
    {
      "offset": 795,
      "name": "StardustNext",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The next dot: its 5 bytes back into the table, then the next one in"
    },
    {
      "offset": 1018,
      "name": "StarPlotAll",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Plot the dots of this pass: XOR each listed address with its mask (StardustNext jumps here after the last dot)"
    },
    {
      "offset": 1039,
      "name": "NegateX",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = -A and StarSigns bit 6 flipped (the dot crossed the axis)"
    },
    {
      "offset": 1052,
      "name": "NegateY",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = -A and StarSigns bit 7 flipped"
    },
    {
      "offset": 1065,
      "name": "MulBits",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = A * C, the low B bits of C (shift and add)"
    },
    {
      "offset": 1085,
      "name": "DivideShifted",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "D = A:L shifted left twice divided by B (StardustFront's depth division)"
    },
    {
      "offset": 1123,
      "name": "DivideFrac8",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "D = A * 256 / B for a small A"
    },
    {
      "offset": 1143,
      "name": "StarAddress",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "DE = the back buffer address of the dot, C = its pixel mask"
    },
    {
      "offset": 1213,
      "name": "StarRespawn",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A dot left the screen: make it again at random for the view"
    },
    {
      "offset": 1493,
      "name": "StarShuffle",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "After a change of view: renumber the dot table (known from the code only)"
    },
    {
      "offset": 1518,
      "name": "StarRandom",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = the next random byte of the dot generator (HL the seed)"
    },
    {
      "offset": 1606,
      "name": "InSystemJump",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The J key: move the sun, the planet and the station $2000 closer when nothing is near"
    },
    {
      "offset": 1685,
      "name": "JumpCloser",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The z coordinate at IX+6..8 moves $2000 towards the ship (a far one by $20 pages, a near one to $2000 on the other side)"
    }
