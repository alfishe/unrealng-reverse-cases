  "entries": [
    {
      "offset": 6,
      "name": "DashDistances",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The sun's and the planet's distances on the bars, the safe zone, the compass"
    },
    {
      "offset": 206,
      "name": "CompassDivide",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = the word at IX divided by DE, times 8, with the sign of IX+1"
    },
    {
      "offset": 269,
      "name": "CompassDivideSigned",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The same for a 3-byte coordinate at IX (the sign bit cleared first)"
    },
    {
      "offset": 302,
      "name": "SetTooClose",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "TooClose = 1"
    },
    {
      "offset": 308,
      "name": "DistanceBand",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = 1.5 * distance; set Condition yellow below $50 pages, red flashing from $78"
    },
    {
      "offset": 351,
      "name": "LoadVector",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "DE, BC, HL = the three top words of the 9-byte vector at IX"
    },
    {
      "offset": 370,
      "name": "VectorLengthAbs",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "VectorLength of the vector at IX with the three signs cleared"
    },
    {
      "offset": 383,
      "name": "VectorLength",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = the length of the vector at IX: sqrt(x^2 + y^2 + z^2) on the top bytes"
    },
    {
      "offset": 493,
      "name": "DrawCompass",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw the compass dial and its dot (the solid dot in front, the ring behind) in a space view"
    },
    {
      "offset": 674,
      "name": "NextLineDown",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = the next pixel line's row start when L passed a character row (the screen's layout)"
    },
    {
      "offset": 684,
      "name": "NextLineUp",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The same going up (known from the code only)"
    },
    {
      "offset": 694,
      "name": "DrawCompassDialArt",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Copy the 24-line dial (CompassDial) to $5035"
    },
    {
      "offset": 822,
      "name": "DrawBars",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Redraw every dashboard bar whose value changed"
    },
    {
      "offset": 925,
      "name": "DrawMarker",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw a roll or pitch marker: a 3-pixel mark at the value"
    },
    {
      "offset": 940,
      "name": "DrawBar",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw a bar: 5 bytes wide, A pixels long, 3 pixel lines"
    },
    {
      "offset": 1123,
      "name": "BarByte",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Write the bar's edge byte C; for a marker keep the frame pixel at the left"
    }
