  "entries": [
    {
      "offset": 0,
      "name": "GalacticChart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen I: the 256 systems as dots, the current system's cross (16) and its fuel circle, the cursor's cross (10), GALACTIC CHART"
    },
    {
      "offset": 114,
      "name": "ClearBlock",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A x 32 bytes before HL cleared on each of the cell's eight pixel rows: SP at HL and PUSHes of zero, the interrupts off"
    },
    {
      "offset": 152,
      "name": "PlotSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The dot of the system in SystemSeeds at (x, y / 2 + 24): PIXEL-ADD $22AA, its bit patched into the SET at $EC35"
    },
    {
      "offset": 191,
      "name": "ClampLow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = 0: the window's low edge when cx - 19 or cy - 34 went below 0"
    },
    {
      "offset": 193,
      "name": "ClampHigh",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = 255: its high edge when cx + 19 or cy + 34 passed 255"
    },
    {
      "offset": 220,
      "name": "ShortRangeChart",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen O: SHORT RANGE CHART, the systems near the current one as icons with their names, the current system's cross (24), the fuel circle, the cursor's cross (16)"
    },
    {
      "offset": 342,
      "name": "EachSystemInWindow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The 256 systems: those inside the window (x and y each low <= v < high) handed to the routine at HL (the CALL at $ECF1 patched)"
    },
    {
      "offset": 385,
      "name": "SystemPixel",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = the screen address of the system's icon (its top left at x 94 + 4 dx, row 93 + 2 dy from the current system), A its bit, B and C the coordinates"
    },
    {
      "offset": 427,
      "name": "DrawSystemIcon",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One of the four ChartIcons (s2 high AND $18: 8 bytes each) XORed in at the system's place, shifted A bits across two bytes, then the next system"
    },
    {
      "offset": 508,
      "name": "LabelSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The system's name at the text cell right of its icon: its own row, else the row above (from row 3), else the row below (to row 22), else none"
    },
    {
      "offset": 585,
      "name": "PrintIfRowFree",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The name in NameBuffer at TextRow unless RowsUsed has it: the row marked and the name printed (carry), else no carry"
    },
    {
      "offset": 611,
      "name": "DataScreen",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen P: DATA ON <system> for the system nearest the cursor: the distance, the economy, government, tech level, population and species, productivity, radius, and its description"
    },
    {
      "offset": 801,
      "name": "PrintCodeGap",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Standard code A, a new line and an empty line"
    },
    {
      "offset": 806,
      "name": "NewLineGap",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A new line and an empty line"
    },
    {
      "offset": 812,
      "name": "PrintEconomy",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "ECONOMY: and RICH / AVERAGE / POOR / MAINLY (codes $AA-$AD) and INDUSTRIAL or AGRICULTURAL (economy / 4: codes $A8, $A9)"
    },
    {
      "offset": 850,
      "name": "PrintSpecies",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The system's people: HUMAN COLONIALS (s2 low below $80), else up to three adjectives and the kind, as the BBC's"
    },
    {
      "offset": 933,
      "name": "PrintRadius",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The radius in km: ((s2 high AND 15) + 11) x 256 + s1 high, five digits"
    },
    {
      "offset": 955,
      "name": "IsFirstSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "No carry when the selected system is the galaxy's first (its six seeds the galaxy's)"
    },
    {
      "offset": 972,
      "name": "MarketPrices",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen K: <system> MARKET PRICES, the heading line (code $FF) and the 17 commodities (MarketRow); in witch space only the heading"
    },
    {
      "offset": 1035,
      "name": "StatusScreen",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen L: COMMANDER <name>, the present and the hyperspace systems, the fuel, the cash, the legal status, the rating, the equipment and the lasers"
    },
    {
      "offset": 1260,
      "name": "PrintIfFitted",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A not 0: the code byte after the CALL on its own line at column 5; the return past the byte either way"
    },
    {
      "offset": 1270,
      "name": "EquipmentLine",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A new line, column 5"
    },
    {
      "offset": 1278,
      "name": "PrintLaser",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The laser of the next view (StatusLaserView one more): FRONT / REAR / LEFT / RIGHT and PULSE / BEAM / MILITARY / MINING LASER; nothing for none"
    },
    {
      "offset": 1317,
      "name": "StatusSystem",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Column 21, \":\" and standard control A (2 the current system, 3 the selected one), a new line"
    },
    {
      "offset": 1340,
      "name": "InventoryScreen",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Screen ENTER: INVENTORY, the fuel, the cash, LARGE CARGO BAY (its line coloured), REFUGEES (MissionFlags bit 5), the hold (HoldRow for each commodity)"
    }
  ],
