    },
    {
      "offset": 599,
      "name": "Normalise",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Make a position vector (IX) a unit one: its length (SquareRoot of the sum of squares) and each part divided by it"
    },
    {
      "offset": 636,
      "name": "SquareComponent",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The square of one 16-bit part (sign bit off) through the squares table: HL low, IX high, IX += 2"
    },
    {
      "offset": 691,
      "name": "DivideComponent",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One part divided by the length (DE), halved, its sign put back"
    },
    {
      "offset": 725,
      "name": "SquareRoot",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "HL = the square root of HL, scaled up or down to keep 12 bits of precision"
    },
    {
      "offset": 764,
      "name": "SquareRootCore",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Two Newton steps from $8000: r = (r + n / r) / 2"
    },
