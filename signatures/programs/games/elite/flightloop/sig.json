  "entries": [
    {
      "offset": 0,
      "name": "FlightLoop",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The main loop: the controls, the view, the pause, the jump keys, the ships, the screen"
    },
    {
      "offset": 275,
      "name": "DrawSunPlanet",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Project and draw the sun and the planet for the view"
    },
    {
      "offset": 335,
      "name": "SunGrowth",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "With SunGrows $D0BA set the sun's circle grows by 2 a frame; past 255 TooClose ends the game"
    },
    {
      "offset": 368,
      "name": "ProjectCircle",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Project CircleVector for the view: the centre, the quadrant bits and the radius, A = 1 if seen"
    },
    {
      "offset": 815,
      "name": "Divide24",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "D = HL:C / DE:B as a fraction (24-bit numbers): the screen offset of a coordinate at a depth"
    },
    {
      "offset": 970,
      "name": "DivideFraction",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "D = A * 256 / B: an 8-bit fraction, B > A"
    },
    {
      "offset": 994,
      "name": "MoveSunPlanet",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Rotate the sun's and the planet's positions by this frame's roll, pitch and speed"
    },
    {
      "offset": 1008,
      "name": "StationRunIn",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "After a launch: move slot 0 (the station) until it is behind the ship, then normal flight"
    }
