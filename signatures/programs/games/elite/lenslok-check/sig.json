    {
      "offset": 531,
      "name": "Lenslok",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The Lenslok check: rounds of a size screen and three attempts; returns on success, resets after two failed rounds"
    },
    {
      "offset": 586,
      "name": "LensFailedRound",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "After a failed round: wait 65536 loops, count LensRounds down, start again or reset"
    },
    {
      "offset": 605,
      "name": "LensRound",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One round: the size screen, the scale, then up to three attempts; LensPassed = 1 or 0"
    },
    {
      "offset": 698,
      "name": "LensClear",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Clear the screen's pixels ($4000-$57FF), leaving the attributes"
    },
    {
      "offset": 713,
      "name": "DrawCode",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw the centre line and the 8 rows of the scrambled code in LensCode"
    },
    {
      "offset": 747,
      "name": "PlotRow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Plot A points to the right from (x C, y B) with the ROM's PLOT"
    },
    {
      "offset": 759,
      "name": "PlotColumn",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Plot A points upwards from (x C, y B) with the ROM's PLOT"
    },
    {
      "offset": 771,
      "name": "DrawRow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw one row of the scrambled code: 14 slices from SlotBits, each a block of lines"
    },
    {
      "offset": 884,
      "name": "PermIndex",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = (IX + n), n the displacement at $C376, then n + 1"
    },
    {
      "offset": 892,
      "name": "SetMarks",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The two mark bytes: Rand(128) with bit 0 cleared, into LensMark1 and LensMark2"
    },
    {
      "offset": 913,
      "name": "LensEdgesWiden",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Widen the outer slices: edges 1 and 2 from edge 3 (minus 5), edges 27 and 28 from edge 26 (plus 5)"
    },
    {
      "offset": 936,
      "name": "AtRow20",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Print position: AT 20,2 (the prompt line)"
    },
    {
      "offset": 942,
      "name": "AtColumn5",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Print position: AT B,5"
    },
    {
      "offset": 952,
      "name": "SliceSpan",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Scale a slice's edges: LensSliceStart = (A x scale) / 10, BC = (D x scale) / 10; A = $80"
    },
    {
      "offset": 991,
      "name": "FillBlock",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Fill one slice of one row: LensRowHeight horizontal runs of the slice's width, one row up each time"
    },
    {
      "offset": 1011,
      "name": "LensMul",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "BC = BC x DE by repeated addition (BC = 0 when DE = 0)"
    },
    {
      "offset": 1032,
      "name": "LensDiv",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "BC = BC / DE by repeated subtraction (the remainder dropped)"
    },
    {
      "offset": 1044,
      "name": "SizeScreen",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The size screen: the bracket, the test code \"OK\", keys 5 / 8 change the width, ENTER returns it in A"
    },
    {
      "offset": 1088,
      "name": "SizeScreenText",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The size screen, continued after its hint line: the bracket, \"OK\" and the keys"
    },
    {
      "offset": 1200,
      "name": "BlankLine",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Print 24 spaces at AT B,5"
