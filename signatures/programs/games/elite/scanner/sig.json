  "entries": [
    {
      "offset": 0,
      "name": "ScannerNext",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The next slot"
    },
    {
      "offset": 3,
      "name": "DrawScanner",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Restore the scanner's background, then a dot and a stalk for each ship within range"
    },
    {
      "offset": 404,
      "name": "ScannerLineDown",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Down a character row; leaving the dashboard ($58xx) abandons the ship's stalk"
    },
    {
      "offset": 422,
      "name": "ScannerLineUp",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Up a character row; above the scanner's first row abandons the ship's stalk"
    },
    {
      "offset": 440,
      "name": "ConditionYellow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Yellow while a ship other than the station is about, unless the condition is red or flashing"
    },
    {
      "offset": 460,
      "name": "ScannerSaveOn",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Patch ScannerCopy to save the screen into ScannerSave, then copy it (known from the code only: 3 runs after a new dashboard)"
    },
    {
      "offset": 503,
      "name": "ScannerRestore",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Once after a frame drew the scanner: clear the 11 x 8 bytes of the dashboard's middle and patch ScannerCopy back to a restore"
    },
    {
      "offset": 566,
      "name": "ScannerCopy",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Copy the scanner's 13 x 48 bytes between ScannerSave and the screen (patched for the direction)"
    },
    {
      "offset": 624,
      "name": "ResetFlight",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The new flight's dashboard: the missiles, the indicators, the bars full or empty, the scanner's colours"
    },
    {
      "offset": 703,
      "name": "FillBlock",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Fill 7 rows of 5 attribute cells with C (DE = 27 the row's rest)"
    },
    {
      "offset": 718,
      "name": "ConditionLight",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Light the condition: red with a shield down, flashing every two frames, the colour on the two cells"
    },
    {
