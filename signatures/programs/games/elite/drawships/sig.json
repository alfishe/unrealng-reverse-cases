  "entries": [
    {
      "offset": 0,
      "name": "DrawShip",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Draw one ship in the view: the depth, the screen position, the gunsight test, then the dot or the wireframe"
    },
    {
      "offset": 349,
      "name": "PlotPixel",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "XOR one pixel at (C, B) into the back buffer through the ROM's PIXEL-ADD ($22B1) with H's bit 7 set"
    },
    {
      "offset": 366,
      "name": "DrawWireframe",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The wireframe: the view's rotation (ViewMatrix), the distance as the detail level, the faces, the vertices, the edges and the laser"
    },
    {
      "offset": 461,
      "name": "ExplosionPoint",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A destroyed ship: its screen point, its size and the quadrant into +$1C-+$1F, the state 11"
    },
    {
      "offset": 511,
      "name": "DrawLaserOnly",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A firing ship that is not drawn still fires: the beam from its screen point"
    },
    {
      "offset": 746,
      "name": "ProjectVertices",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Each vertex whose visibility distance passes and one of whose faces is visible is rotated and projected"
    },
    {
      "offset": 817,
      "name": "EitherFace",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "NZ when one of the two faces in A's nibbles is visible"
    },
    {
      "offset": 833,
      "name": "FaceIsVisible",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "NZ when face A is visible"
    },
    {
      "offset": 844,
      "name": "RotateVertexScaled",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One rotated part of a scaled vertex: three products with a matrix row, summed; a repeat reuses the products with new signs"
    },
    {
      "offset": 1052,
      "name": "AddSignedBytes",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A = L + E with the signs in H and D (bit 7), the sign out in H"
    },
