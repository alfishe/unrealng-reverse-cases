  "entries": [
    {
      "offset": 0,
      "name": "Click",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "With the sound on (Options bit 7) a short beep through the ROM's BEEPER (HL = $80, DE = $60)"
    },
    {
      "offset": 15,
      "name": "WaitKey",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "20 frames, the key bytes cleared, then wait for a key: A = its code (KeyCode $FC0D)"
    },
    {
      "offset": 29,
      "name": "ClearKeys4",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The four key bytes $FC08-$FC0B zeroed with the interrupts off"
    },
    {
      "offset": 42,
      "name": "MarketRow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One commodity of the market: its name, the unit, the price (4 digits and the point), the stock and its unit; carry when the stock is 0 (\"-\")"
    },
    {
      "offset": 128,
      "name": "HoldRow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One line of the hold: nothing (carry) for 0 units, else the name, column 13, the count (3 digits) and the unit"
    },
    {
      "offset": 170,
      "name": "PrintOtherColon",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Other token A and \":\""
    },
    {
      "offset": 175,
      "name": "PrintCodeColon",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Standard code A and \":\""
    },
    {
      "offset": 182,
      "name": "PrintCodeSpace",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Standard code A and a space"
    },
    {
      "offset": 190,
      "name": "PrintCodeLine",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Standard code A and a new line"
    },
    {
      "offset": 193,
      "name": "NewLine",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Column 0 of the next row (a capital next)"
    },
    {
      "offset": 207,
      "name": "ColumnZero",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Column 0"
    },
    {
      "offset": 212,
      "name": "ColumnInline",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The column from the byte after the CALL"
    },
    {
      "offset": 216,
      "name": "SetColumn",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Column A; 32 and more is a new line"
    },
    {
      "offset": 224,
      "name": "SetRow",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Row A; 24 and more is row 1, column 0"
    },
    {
      "offset": 237,
      "name": "DeleteChar",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "One letter back on row 21 or 22 (ReadLine's DELETE): the cell's eight pixel rows cleared"
    },
    {
      "offset": 272,
      "name": "PrintCapitals",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Standard code A in capitals (control 6), then sentence case (control 8)"
    },
    {
      "offset": 286,
      "name": "PageTitle",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "A screen's title: code A in capitals, the condition light, and code $77 (three new lines)"
    },
    {
      "offset": 297,
      "name": "PrintCodes",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The zero-ended standard codes at HL; carry at the end"
    },
    {
      "offset": 310,
      "name": "PrintUnit",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "The unit of MarketItem in small letters: t (0-12, 16), kg (13, 14), g (15), km (17: the data screen's radius)"
    },
    {
      "offset": 356,
      "name": "IsTonnes",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "Carry when MarketItem is sold in tonnes (0-12 and 16): BuyCheck and SellCheck count only those against the free space"
    },
    {
      "offset": 370,
      "name": "Wait20",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "20 frames"
