    },
    {
      "offset": 432,
      "name": "PlanetNamePrompt",
      "in": null,
      "out": null,
      "clobbers": null,
      "summary": "PLANET NAME? (other $0E, 8 letters): the system found becomes the selected one, else \"<name> NOT FOUND\""
    },
    {
      "offset": 484,
      "name": "ReadLine",
      "in": null,
      "out": null,
      "clobbers": null,
