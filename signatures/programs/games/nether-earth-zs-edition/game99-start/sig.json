  "labels": [
    {
      "offset": 0,
      "name": "",
      "comment": "the start-up menu (stage 3's piece at $C100); START returns here"
    },
    {
      "offset": 3,
      "name": "",
      "comment": "no interrupts while the vector table is built"
    },
    {
      "offset": 4,
      "name": "",
      "comment": "SP = 0: the stack grows down from $FFFF"
    },
    {
      "offset": 7,
      "name": "",
      "comment": "the IM 2 table: 257 bytes of $FD at $FE00-$FF00"
    },
    {
      "offset": 10,
      "name": "",
      "comment": "B = 0: 256 bytes, C = $FD the byte stored"
    },
    {
      "offset": 13,
      "name": "FillVectorTable",
      "comment": "one vector byte"
    },
    {
      "offset": 14,
      "name": "",
      "comment": "the next"
    },
    {
      "offset": 15,
      "name": "",
      "comment": "256 times"
    },
    {
      "offset": 17,
      "name": "",
      "comment": "the 257th byte, $FF00: the vector $FEFF (bus byte $FF) reads its high byte here"
    },
    {
      "offset": 18,
      "name": "",
      "comment": "the JP opcode"
    },
    {
      "offset": 20,
      "name": "",
      "comment": "at $FDFD: every vector lands on Handler"
    },
    {
      "offset": 23,
      "name": "",
      "comment": "StartInterrupt (EI; RET) until EnterPlay"
    },
    {
      "offset": 26,
      "name": "",
      "comment": "Handler = StartInterrupt"
    },
    {
      "offset": 29,
      "name": "",
      "comment": "I = $FE: the vector table's page"
    },
    {
      "offset": 31,
      "name": "",
      "comment": "I points at $FE00"
    },
    {
      "offset": 33,
      "name": "",
      "comment": "IM 2: the interrupt jumps through ($FE00 + the bus byte) = $FDFD"
    },
    {
      "offset": 35,
      "name": "",
      "comment": "interrupts on from here"
    },
    {
      "offset": 36,
      "name": "",
      "comment": "the random seed $39,$30 (12345)"
    },
    {
      "offset": 39,
      "name": "",
      "comment": "$FD00-$FD01"
    },
    {
      "offset": 42,
      "name": "",
      "comment": "$FD02-$FD03: the same seed at every start, so each game begins the same"
    },
    {
      "offset": 45,
      "name": "",
      "comment": "two NOPs: no loaded game to skip to"
    },
    {
      "offset": 117,
      "name": "",
      "comment": "row 14"
    },
    {
      "offset": 119,
      "name": "",
      "comment": "ShipY = 14"
    },
    {
      "offset": 131,
      "name": "",
      "comment": "99 of the general resource for us: the operand at $A684 is the map's (LOAD MAP)"
    },
    {
      "offset": 133,
      "name": "",
      "comment": "Resources+0, our general resource"
    },
    {
      "offset": 136,
      "name": "",
      "comment": "the enemy's seven resources = 99 each"
    },
    {
      "offset": 142,
      "name": "",
      "comment": "clear the view buffer, paint the corners outside the map"
    },
    {
      "offset": 145,
      "name": "",
      "comment": "the whole play screen: view, frame, radar, status panel"
    },
    {
      "offset": 148,
      "name": "",
      "comment": "PlayInterrupt from now on"
    },
    {
      "offset": 151,
      "name": "",
      "comment": "Handler: the frame count $FD34 and the radar each frame"
    },
    {
      "offset": 154,
      "name": "",
      "comment": "the controls; the pause while key 1 is held"
    },
    {
      "offset": 157,
      "name": "",
      "comment": "the ship (unless a robot is under direct control)"
    },
    {
      "offset": 160,
      "name": "",
      "comment": "the robots and the shots"
    },
    {
      "offset": 163,
      "name": "",
      "comment": "the view"
    },
    {
      "offset": 166,
      "name": "",
      "comment": "the turn: clock, captures, game end, frame pacing"
    },
    {
      "offset": 169,
      "name": "",
      "comment": "HL = the map cell under the ship"
    },
    {
      "offset": 172,
      "name": "",
      "comment": "bit 6: a robot or a building under the ship"
    },
    {
      "offset": 174,
      "name": "",
      "comment": "nothing there: only the game keys"
    },
    {
      "offset": 176,
      "name": "",
      "comment": "one of ours? B = 48 - slot"
    },
    {
      "offset": 179,
      "name": "",
      "comment": "not a robot: try a building"
    },
    {
      "offset": 181,
      "name": "",
      "comment": "B = 48 - the slot"
    },
    {
      "offset": 182,
      "name": "",
      "comment": "slots 24-47 (B < 25) are the enemy's"
    },
    {
      "offset": 184,
      "name": "",
      "comment": "an enemy robot: no menu"
    },
    {
      "offset": 186,
      "name": "",
      "comment": "the ship must rest exactly on the robot's top"
    },
    {
      "offset": 189,
      "name": "",
      "comment": "minus the robot's height +$09 (its parts)"
    },
    {
      "offset": 192,
      "name": "",
      "comment": "minus its ground +$0D: 0 when the ship sits on its top"
    },
    {
      "offset": 195,
      "name": "",
      "comment": "landed on our robot"
    },
    {
      "offset": 198,
      "name": "",
      "comment": "then the game keys"
    },
    {
      "offset": 200,
      "name": "CheckWarbasePad",
      "comment": "not a robot: a building?"
    },
    {
      "offset": 203,
      "name": "",
      "comment": "neither robot nor building record here: the game keys"
    },
    {
      "offset": 205,
      "name": "",
      "comment": "type 0: the pad of our warbase"
    },
    {
      "offset": 208,
      "name": "",
      "comment": "building type +$02 = 0?"
    },
    {
      "offset": 209,
      "name": "",
      "comment": "other buildings open nothing"
    },
    {
      "offset": 211,
      "name": "",
      "comment": "the pad's top is 15"
    },
    {
      "offset": 214,
      "name": "",
      "comment": "altitude 15?"
    },
    {
      "offset": 216,
      "name": "",
      "comment": "the ship has not landed on the pad yet"
    },
    {
      "offset": 218,
      "name": "",
      "comment": "HL = the pad's cell + 4 rows: the door, where the robot appears"
    },
    {
      "offset": 221,
      "name": "",
      "comment": "the cell's high byte"
    },
    {
      "offset": 224,
      "name": "",
      "comment": "+ 8 = 4 map rows of $200 bytes down"
    },
    {
      "offset": 226,
      "name": "",
      "comment": "HL = the door cell"
    },
    {
      "offset": 227,
      "name": "",
      "comment": "the door's flags"
    },
    {
      "offset": 228,
      "name": "",
      "comment": "the door, the cell below it and its two neighbours"
    },
    {
      "offset": 229,
      "name": "",
      "comment": "$200 on: HL = the cell under the door"
    },
    {
      "offset": 230,
      "name": "",
      "comment": "its flags"
    },
    {
      "offset": 231,
      "name": "",
      "comment": "its left neighbour"
    },
    {
      "offset": 232,
      "name": "",
      "comment": "its flags"
    },
    {
      "offset": 233,
      "name": "",
      "comment": "back to the cell under the door"
    },
    {
      "offset": 234,
      "name": "",
      "comment": "its right neighbour"
    },
    {
      "offset": 235,
      "name": "",
      "comment": "its flags: A = the four cells' bits ORed"
    },
    {
      "offset": 236,
      "name": "",
      "comment": "any of them taken: no menu"
    },
    {
      "offset": 238,
      "name": "",
      "comment": "a robot or building in the way: the menu stays shut"
    },
    {
      "offset": 240,
      "name": "",
      "comment": "IY = the free robot slot it filled (or $DB80 when none was free)"
    },
    {
      "offset": 243,
      "name": "",
      "comment": "the new robot's start state"
    },
    {
      "offset": 247,
      "name": "",
      "comment": "+$06 = 5 steps on that course"
    },
    {
      "offset": 251,
      "name": "",
      "comment": "order 0: stop and defend"
    },
    {
      "offset": 255,
      "name": "",
      "comment": "strength 100 %"
    },
    {
      "offset": 259,
      "name": "",
      "comment": "+$0F = 1: its first step at once"
    },
    {
      "offset": 263,
      "name": "",
      "comment": "recount the robots of both sides"
    },
    {
      "offset": 266,
      "name": "",
      "comment": "reprint the status values"
    },
    {
      "offset": 269,
      "name": "CheckGameKeys",
      "comment": "Input bit 6 (key I): abandon the game"
    },
    {
      "offset": 272,
      "name": "",
      "comment": "key I held?"
    },
    {
      "offset": 274,
      "name": "",
      "comment": "abandon: Start, the start-up menu again"
    },
    {
      "offset": 277,
      "name": "",
      "comment": "the next turn (NE tested the save key here)"
    },
    {
