  "labels": [
    {
      "offset": 16,
      "name": "",
      "comment": "paper = B-1"
    },
    {
      "offset": 27,
      "name": "",
      "comment": "the whole screen and its attributes to 0"
    },
    {
      "offset": 40,
      "name": "",
      "comment": "stream 2: the upper screen"
    },
    {
      "offset": 45,
      "name": "",
      "comment": "DF SZ = 0: PR-STRING may print on lines 22 and 23"
    },
    {
      "offset": 49,
      "name": "",
      "comment": "\"NETHER  EARTH\", \"ZS Edition'99\", \"System checking...\", \"Computer \""
    },
    {
      "offset": 55,
      "name": "",
      "comment": "$5CB0 = the scheme bits, $5CB1 = the page count"
    },
    {
      "offset": 58,
      "name": "",
      "comment": "no scheme bit: \"Spectrum\""
    },
    {
      "offset": 67,
      "name": "",
      "comment": "B = 1 + the number of clear bits above the highest set one"
    },
    {
      "offset": 70,
      "name": "",
      "comment": "the B-th string after the $FF at $67B0"
    },
    {
      "offset": 76,
      "name": "PrintMemory",
      "comment": "the machine's name, \"Memory \""
    },
    {
      "offset": 85,
      "name": "",
      "comment": "BC = 48 when the count is 1"
    },
    {
      "offset": 91,
      "name": "",
      "comment": "count - 1 + 4 = count + 3, with the carry out of the ADD when the count is 0"
    },
    {
      "offset": 99,
      "name": "",
      "comment": "BC = (A:carry) * 16: (count + 3) * 16, or (3 + 4) * 8 = 56 for count 0"
    },
    {
      "offset": 115,
      "name": "PrintMemSize",
      "comment": "the number, then \"Kb\", \"Using \""
    },
    {
      "offset": 127,
      "name": "",
      "comment": "PROG below $5D3B: no TR-DOS variables, the tape path"
    },
    {
      "offset": 142,
      "name": "",
      "comment": "the TR-DOS ROM's version text"
    },
    {
      "offset": 145,
      "name": "",
      "comment": "its $FF end"
    },
    {
      "offset": 148,
      "name": "",
      "comment": "\"TR-DOS Ver 5.03 \" as the ROM holds it"
    },
    {
      "offset": 154,
      "name": "",
      "comment": "\"Loading...\", \"Game... \""
    },
    {
      "offset": 160,
      "name": "",
      "comment": "the game block: 68 sectors to $6780, over these strings from $6780 on"
    },
    {
      "offset": 171,
      "name": "",
      "comment": "\"Drivers... \""
    },
    {
      "offset": 177,
      "name": "",
      "comment": "the patches block: 4 sectors to $DC00"
    },
    {
      "offset": 188,
      "name": "",
      "comment": "the disk sector reader to $A598"
    },
    {
      "offset": 199,
      "name": "",
      "comment": "the disk LOAD MAP to $C1FD"
    },
    {
      "offset": 210,
      "name": "",
      "comment": "the one-page TextLoader and jump table first"
    },
    {
      "offset": 213,
      "name": "",
      "comment": "the files after the patches block, in disk order: menu 10 sectors, about 15, description 22, greets 2, advices 22"
    },
    {
      "offset": 257,
      "name": "",
      "comment": "the advices position"
    },
    {
      "offset": 263,
      "name": "",
      "comment": "bug: B of the advices' LD BC is AdviceLen+1 ($C134); $C133 is C. The one-page table never runs (see MemoryTest)"
    },
    {
