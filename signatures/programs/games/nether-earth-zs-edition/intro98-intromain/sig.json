  "labels": [
    {
      "offset": 1,
      "name": "",
      "comment": "the player set up: the module's pointers, the AY silent (Pt3Init leaves interrupts off)"
    },
    {
      "offset": 4,
      "name": "",
      "comment": "the IM 2 table: $8100-$8200, 257 bytes of $80 ..."
    },
    {
      "offset": 17,
      "name": "",
      "comment": "... so every vector is $8080, where a JP IntroInterrupt goes"
    },
    {
      "offset": 29,
      "name": "",
      "comment": "$7FFD = $10: page 0 at $C000, the 48 K BASIC ROM, screen 5 (the loader's own state)"
    },
    {
      "offset": 36,
      "name": "",
      "comment": "I = $81: the table above; IM 2 on"
    },
    {
      "offset": 43,
      "name": "",
      "comment": "the loader's title text faded out (128 frames)"
    },
    {
      "offset": 46,
      "name": "",
      "comment": "then the screen cleared, white on black, border black"
    },
    {
      "offset": 49,
      "name": "",
      "comment": "the bottom third's attributes ($5A00-$5AFF): yellow ink on black (the robot's box, RobotHeader's colour)"
    },
    {
      "offset": 54,
      "name": "BottomAttrLoop",
      "comment": ""
    },
    {
      "offset": 59,
      "name": "",
      "comment": "the bars' cells, rows 23 and 22: column 0 red (channel A) ..."
    },
    {
      "offset": 67,
      "name": "",
      "comment": "... column 1 yellow (B) ..."
    },
    {
      "offset": 75,
      "name": "",
      "comment": "... column 2 green (C)"
    },
    {
      "offset": 83,
      "name": "",
      "comment": "LAST_K = 0: the loop runs until the ROM's keyboard scan stores a key"
    },
    {
      "offset": 87,
      "name": "IntroLoop",
      "comment": "a frame of the intro"
    },
    {
      "offset": 93,
      "name": "",
      "comment": "wait for the frame (the interrupt has played the tune and moved the scroller)"
    },
    {
      "offset": 94,
      "name": "",
      "comment": "AY register 2 (channel B's tone, low byte) ..."
    },
    {
      "offset": 103,
      "name": "",
      "comment": "... its low 5 bits pick a cell of row 9 ($5920-$593F): paper red"
    },
    {
      "offset": 112,
      "name": "",
      "comment": "the cell's address kept to clear it at the end of the frame"
    },
    {
      "offset": 113,
      "name": "",
      "comment": "AY register 4 (channel C's tone, low byte): a cell of row 9 in yellow"
    },
    {
      "offset": 132,
      "name": "",
      "comment": "AY register 6 (the noise period): a cell of row 9 in green"
    },
    {
      "offset": 151,
      "name": "",
      "comment": "the bars, three times ..."
    },
    {
      "offset": 160,
      "name": "",
      "comment": "every 32 frames (FRAMES' low byte & $1F = 0) the robot's next frame"
    },
    {
      "offset": 168,
      "name": "",
      "comment": "the bars again ..."
    },
    {
      "offset": 171,
      "name": "",
      "comment": "the logo in the colour FRAMES & 7"
    },
    {
      "offset": 179,
      "name": "",
      "comment": "... and once more"
    },
    {
      "offset": 182,
      "name": "",
      "comment": "the three cells of row 9 back to black: they show only while this frame is drawn"
    },
    {
      "offset": 193,
      "name": "IntroEnd",
      "comment": "I = $3F (the ROM's value), IM 0: the bus reads $FF, so the interrupt is RST $38 as under IM 1"
    },
    {
      "offset": 200,
      "name": "",
      "comment": "the AY silent"
    },
    {
      "offset": 204,
      "name": "",
      "comment": "the screen faded out by the same diagonal sweep (128 frames)"
    },
    {
      "offset": 211,
      "name": "",
      "comment": "A * 8: the paper colour ..."
    },
    {
      "offset": 214,
      "name": "",
      "comment": "... into LogoInk's operand"
    },
    {
      "offset": 217,
      "name": "",
      "comment": "the logo's 64 mask bytes, 8 rows of 8 cells"
    },
