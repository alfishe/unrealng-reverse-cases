  "labels": [
    {
      "offset": 0,
      "name": "CompileHeader",
      "comment": "Eleven bytes the compiler leaves in front of the jumps"
    },
    {
      "offset": 13,
      "name": "InitPad",
      "comment": "A padding byte after the JR (NOP)"
    },
    {
      "offset": 16,
      "name": "PlayPad",
      "comment": "A padding byte after the JR (NOP)"
    },
    {
      "offset": 19,
      "name": "MutePad",
      "comment": "A padding byte after the JR (NOP)"
    },
    {
      "offset": 20,
      "name": "CompileText",
      "comment": "\"SOUND TRACKER COMPILATION OF NE___MUS   BY KSA SOFTWARE\" and the byte $7F"
    },
    {
      "offset": 79,
      "name": "",
      "comment": "register 12, the envelope period's high byte, is selected"
    },
    {
      "offset": 83,
      "name": "",
      "comment": "A = 0 to the data port first, then 1, 2 ... in MuteLoop"
    },
    {
      "offset": 98,
      "name": "",
      "comment": "interrupts off while the variables are half set"
    },
    {
      "offset": 99,
      "name": "",
      "comment": "the module's first byte: frames a row"
    },
    {
      "offset": 103,
      "name": "",
      "comment": "the module address into ModuleOffset's operand"
    },
    {
      "offset": 107,
      "name": "",
      "comment": "DE = the positions list ..."
    },
    {
      "offset": 110,
      "name": "",
      "comment": "... its first byte: the last position's index"
    },
    {
      "offset": 112,
      "name": "",
      "comment": "+ 1: the count of positions"
    },
    {
      "offset": 120,
      "name": "",
      "comment": "DE = the ornaments"
    },
    {
      "offset": 128,
      "name": "",
      "comment": "DE = the patterns"
    },
    {
      "offset": 135,
      "name": "",
      "comment": "DE = the samples (module + 27)"
    },
    {
      "offset": 145,
      "name": "",
      "comment": "channel A's stream at the $FF of PatternEnd"
    },
    {
      "offset": 151,
      "name": "",
      "comment": "ChannelState..AYEnvShape cleared (45 bytes)"
    },
    {
      "offset": 163,
      "name": "",
      "comment": "ornament 0: found in the ornament list"
    },
    {
      "offset": 171,
      "name": "",
      "comment": "A = $FF: every channel's sample counter ..."
    },
    {
      "offset": 181,
      "name": "",
      "comment": "... and the delay counter at 1: the next Play reads a row"
    },
    {
      "offset": 186,
      "name": "",
      "comment": "every channel plays ornament 0 (its offsets, past the number byte)"
    },
    {
      "offset": 196,
      "name": "",
      "comment": "the registers once"
    },
