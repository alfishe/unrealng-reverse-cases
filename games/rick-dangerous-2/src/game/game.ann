# The annotations of the game image: the single source of truth for src/game/*.asm (kit/mkgame.py).
# The format is in kit/mkgame.py, class Annotations. One line an entry:
#
#   @module NAME ; title            the entries from here on go to NAME.asm, the title heads the file
#   @about a paragraph              the module file's header text, one paragraph a line
#   $ADDR c Name ; title            a routine
#   > a description line
#   $ADDR b Name ; title            data (w words, t text, s space; "b Name 8" rows of 8)
#   @res graphics/NAME.bin          the entry is a resource: src/res/..., INCBIN
#   $ADDR Name ; comment            a label and comment inside an entry: on an instruction, or on the data line
#                                   that starts at ADDR (a data entry's rows are cut there)
#   @isub $ADDR LD HL,-6            the instruction written so
#   @equ $ADDR Name [N] ; comment    a variable past the image: an EQU, its operands by name
#   @inline $ADDR                   a routine that reads its data after the CALL


@equ $4000 Screen 6144 ; the screen bitmap; row 0 is the HUD, rows 1-23 the view
@equ $5800 ScreenAttrs 768 ; the screen attributes
@equ $5DE8 SpareCells 424 ; the composed cells: spare cell n at SpareCells + 8 x (n + 1), n = 2... (SpareCount $77B0)
@equ $6000 MusicImage 4224 at $7BC3 ; the AY music as loaded, copied to RAM 1 at $C000 on a 128K
@equ $6500 MirrorTable 256 ; the 256 bytes bit-reversed: a mirrored sprite's bytes go through it
@equ $6600 DirtyMap 1280 ; a byte per view cell, 32 x 40, row 8 = screen row 0: 0 nothing to do, 1 restore the level cell, n >= 2 show spare cell n; $6A00 = $FF ends the scan
@equ $6B00 ViewCells 1408 ; the view's cell numbers, 32 x 44 (the map builder), row 8 = screen row 0; DirtyMap + $500
@equ $A800 CellFlags 256 ; a flag byte per cell (bit 1 solid, bit 2 floor, bit 5 deadly to the bomb; bit 7 the composer)
@equ $A900 CellGraphics 2048 ; 256 cells of 8 bytes
@equ $B100 CellAttrs 256 ; a cell's attribute
@equ $B200 Blocks 4096 at $8905 ; 256 blocks of 4 x 4 cell numbers
@equ $C000 PageC000 at $7B97,$7BA5,$7BAC,$7BC6 ; the first byte of the $C000 page: the 128K test byte, the music's destination in RAM 1
@equ $C200 LevelHeader 6 ; +0 the address of the level's object kind table (11-byte records), +2 the section table's, +4 the maps' base
@equ $C206 LevelHookA 3 ; level 5: JP $F7E6, run in place of the map entry scan while LevelHookOn is set
@equ $C209 LevelHookB 3 ; level 5: JP $F8D0
@equ $C20C LevelNumber ; the level in memory, 1-5
@equ $C20E SpriteFrameMap ; a byte per animation frame 1-$7F: the sprite number, bit 7 mirrored, $7F none
@equ $C26D Sprites ; the level's sprites, 128 bytes each (sprites 0-24 Rick, his shots and the blast in every level)
@names 1 ../music/music.ann ; the AY music in RAM 1 (src/music): the entries the game calls through CallRam1
@bank $CA27 1 ; start tune A
@bank $CAAF 1 ; the player, once a frame
@bank $CCC8 1 ; start effect A
@bank $C9CF 1 ; a tune runs
@equ $FD00 Im2Table 257 at $7C26 ; the IM 2 vector table, every byte $FE
@equ $FEFE Im2Handler 35 at $7BE7,$7BED,$7C1E ; the IM 2 handler, copied from Im2HandlerSource

@isub $7365 LD BC,ViewCells
@isub $7349 LD BC,SpareCells+8
@isub $779B LD BC,SpareCells+8
@isub $7838 LD BC,SpareCells+16
@isub $76FC LD BC,SpareCells
@isub $747A LD H,MirrorTable/256
@isub $7489 LD H,MirrorTable/256
@isub $7614 LD H,MirrorTable/256
@isub $7623 LD D,MirrorTable/256
@isub $7755 LD B,CellFlags/256
@isub $772F LD BC,CellGraphics
@isub $7776 LD BC,CellGraphics
@isub $7800 ADD A,CellGraphics/256
@isub $77F4 LD H,CellAttrs/256
@isub $7829 LD H,CellAttrs/256
@isub $7842 LD D,CellAttrs/256
@isub $7397 LD BC,-3*32+1
@isub $73B3 LD BC,-3*32+1
@isub $73FC LD BC,-2*32+1
@isub $7411 LD BC,-2*32+1
@isub $73DF LD BC,-3*32
@isub $7436 LD BC,-3*24
@isub $74E9 LD BC,-2*32+1
@isub $74FE LD BC,-2*32+1
@isub $7513 LD BC,-2*32+1
@isub $7540 LD BC,-4*24
@isub $7564 LD BC,-3*32+1
@isub $7580 LD BC,-3*32+1
@isub $759C LD BC,-3*32+1
@isub $75B9 LD BC,-4*32
@isub $78F5 LD BC,-64
@isub $790B LD DE,-32
@isub $7955 LD BC,64
@isub $7AA3 LD HL,MusicEffect
@isub $7AAE LD HL,MusicStartTune
@isub $7AB7 LD HL,MusicFrame
@isub $7ACC LD A,(MusicPlaying)

@module hud ; The HUD and the glyphs: score, detonators, ammunition, lives
@about The top character row of the screen is the HUD: the score's six digits at columns 1-6 (white), up to six detonators at columns 9-14 (red), up to six ray-gun bolts at columns 17-22 (magenta) and up to six lives (Rick's head) at columns 25-30 (green). DrawHud $796F clears and colours the row and draws all four; the game calls DrawLives, DrawAmmo, DrawDetonators and DrawScore alone when one value changes. Glyphs are 8 x 8, drawn straight into the screen by DrawGlyph $7A2C.
@about The same 40 glyphs $7080 are the game's text font: the text printer $88B1 points the cell drawers' graphics base at $7080 instead of CellGraphics, so a text is a buffer of glyph numbers (ASCII - $34: "A" = 13, "0" = -4, which is why the menus store a digit 4 higher, "5" for 1).

$7080 b Glyphs 8 ; The 40 glyphs of the HUD and the texts, 8 bytes each: 0-9, bolt, detonator, life, A-Z, blank
> Glyph n at $7080 + 8n: 0-9 the digits ($7080-$70CF), 10 the ray gun's bolt ($70D0, DrawAmmo $79D1), 11 a detonator ($70D8, DrawDetonators $79DF), 12 Rick's head ($70E0, DrawLives $79C3), 13-38 the letters A-Z ($70E8-$71B7), 39 a blank ($71B8). Read by DrawGlyph $7A2C (the HUD and the texts: $7080-$70EF, $7100-$719F in the recordings) and, as cell graphics, by DrawChangedCells $76D4 and ComposeCell $7755 when the text printer $88B1 has switched them to the font ($7080-$71BF read by both).
@res graphics/glyphs.bin
$70D0 GlyphBolt ; 10: a ray-gun bolt (ammunition)
$70D8 GlyphDetonator ; 11: a detonator
$70E0 GlyphLife ; 12: Rick's head (a life)
$70E8 GlyphLetters ; 13-38: A-Z
$71B8 GlyphBlank ; 39: blank

@module controls ; The controls: the keyboard, Kempston, cursor and Sinclair joysticks, pause, quit and the cheat keys
@about ReadControls $7254 runs in every interrupt (the IM 2 handler $FEFE calls it) and leaves the controls of the chosen method ControlMethod $7252 in Controls $7253, active low: bit 0 right, 1 left, 2 down, 3 up, 4 fire. The keyboard is Z left, X right, O up, K down, SPACE or ENTER fire; the cursor keys 5-8 and 0, Kempston port $1F and Sinclair 6-0 are the other methods.
@about The main loop polls the other keys directly: E quits ($724A), P pauses ($7242), C+S+3 together toggle the infinite lives ($71C0), SPACE+N+ENTER+J+Y together set a section cheat once the game has been completed ($71DC). The menus test 0-5 ($71F9-$7221) and wait on any fire key ($7229).

$71C0 c TestInfiniteLivesKeys ; Z when C, S and 3 are held together (and no other key of their half rows)
> Reads the half rows $FEFE (C alone: AND $1F = $17), $FDFE (S alone: $1D) and $F7FE (3 alone: $1B); returns NZ at the first that does not match, Z when all three do. The main loop $7D33 then plays tune 1 and toggles $8066 (XOR $FF), the flag the life loss $8A26 tests before it takes a life (and $9593, $95ED, $96B4, $9B27 read): an infinite-lives cheat.
> Only the first half row ran: $71CA-$71DB (the S and 3 tests) ran in no recording, and the static walk takes them for data (every byte of the block is read once in the fast L1), so they are written as DEFB: LD B,$FD / IN A,(C) / AND $1F / CP $1D / RET NZ / LD B,$F7 / IN A,(C) / AND $1F / CP $1B / RET.
> Witness: L1 119134 (cheats, controls-cursor, controls-kempston, controls-keyboard, controls-sinclair, end-congrats, long-l4, rzx-l1-00000-poke, rzx-l1-02000-poke, rzx-l1-04000-poke, rzx-l1-06000-poke, rzx-l1-08000-poke, rzx-l1-10000-poke, rzx-l1-12000-poke, rzx-l1-14000-poke, rzx-l1-16000-poke, rzx-l1-18000-poke, rzx-l1-20000-poke, rzx-l1-22000-poke, rzx-l1-24000-poke, rzx-l2-00000-poke, rzx-l2-02000-poke, rzx-l2-04000-poke, rzx-l2-06000-poke, rzx-l2-08000-poke, rzx-l2-10000-poke, rzx-l2-12000-poke, rzx-l2-14000-poke, rzx-l2-16000-poke, rzx-l2-18000-poke, rzx-l2-20000-poke, rzx-l2-22000-poke, rzx-l2-24000-poke, rzx-l3-00000-poke, rzx-l3-02000-poke, rzx-l3-04000-poke, rzx-l3-06000-poke, rzx-l3-08000-poke, rzx-l3-10000-poke, rzx-l4-00000-poke, rzx-l4-02000-poke, rzx-l4-04000-poke, rzx-l4-06000-poke, rzx-l4-08000-poke, rzx-l4-10000-poke, rzx-l4-12000-poke, rzx-l4-14000-poke, rzx-l4-16000-poke, rzx-l4-18000-poke, rzx-l4-20000-poke, rzx-l5-00000-poke, rzx-l5-02000-poke, rzx-l5-04000-poke, rzx-l5-06000-poke, rzx-l5-08000-poke, rzx-l5-10000-poke, rzx-l5-12000-poke, rzx-l5-14000-poke, rzx-l5-16000-poke, rzx-l5-18000-poke, rzx-l5-20000-poke, rzx-l5-22000-poke, rzx-l5-full, sec-l1-s8, c1, c48, load-l2-load-l5, sec-l2-s7, sec-l2-s10-sec-l2-s12, sec-l3-s3-sec-l3-s5, sec-l3-s7-sec-l3-s9, sec-l4-s x5, sec-l5-s3, sec-l5-s5).
$71CA TestInfiniteLivesRest ; LD B,$FD; IN A,(C); AND $1F; CP $1D (S); RET NZ; LD B,$F7; IN A,(C); AND $1F; CP $1B (3); RET

$71DC c TestSectionCheatKeys ; Z when SPACE+N, ENTER+J and Y are held together
> Reads $7FFE (SPACE and N: AND $1F = $16), $BFFE (ENTER and J: $16) and $DFFE (Y: $0F); NZ at the first mismatch. The main loop $7D49: when $8065 is set (the four levels completed in one game, which opens level 5) it plays tune 1 and sets $8067 = $FF, whose bit 7 the section test $8993 reads ($89D9): a cheat that only works after the game is finished.
> $71E6-$71F8 (the ENTER+J and Y tests) ran in no recording and are DEFB (as $71CA): LD BC,$BFFE / IN A,(C) / AND $1F / CP $16 / RET NZ / LD B,$DF / IN A,(C) / AND $1F / CP $0F / RET.
