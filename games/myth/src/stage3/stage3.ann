$DEE7 PieceSprite1 ; the second frame, the HUD's picture of a later piece
$DFB3 PieceFrameTable ; 10 records
@res stage3/sprites-piece.bin
$DFEF b StrikeableSprites 8 ; The urns and chests: 8 frames, two of each (whole, cracked) for the kinds 0-3 (StrikeableActor $A9C2)
> Read in rzx-r3 (all 250 bytes).
$E0B9 StrikeableFrameTable ; 8 records
@res stage3/sprites-strikeable.bin
$E0E9 b HeroStrikeSprites 8 ; The hero's strikes with a hammer: 4 frames
> Read in rzx-r3 and s3-right (all 309 bytes).
$E206 HeroStrikeFrameTable ; 4 records
@res stage3/sprites-hero-strike.bin
$E21E b EnergyBarPattern 6 ; The energy bar's pattern: 6 bytes, one pixel line (DrawEnergyBar draws Energy / 8 of them on 6 lines)
> Read in rzx-r3 and s3-right.
@res stage3/bitmaps-energy-bar-6x1.bin
$E224 b HeroJumpSprites 8 ; The hero's jump: 19 frames
> Read in rzx-r3 and s3-right (all 1020 bytes).
$E5AE HeroJumpFrameTable ; 19 records
@res stage3/sprites-hero-jump.bin
$E620 b HeroWalkSprites 8 ; The hero walking and standing: 13 frames
> Read in rzx-r3 and s3-right (all 728 bytes).
$E8AA HeroWalkFrameTable ; 13 records
@res stage3/sprites-hero-walk.bin
$E8F8 b FragmentSprites 3 ; A fragment of a broken urn: 8 copies of 3 bytes x 11 lines, shifted 0-7 pixels ($E8F8 + 33 x shift)
> Read in rzx-r3 (all 264 bytes).
@res stage3/bitmaps-fragment-3x11.bin
$EA00 b ItemIconSprites 2 ; The item icons: 9 of 2 bytes x 16 lines (the first item kind 2's), for the HUD's strip and the items on the floor (ItemIcons $7F2F; kind 4 is BlankIcon $8A44)
> DrawItemIcon and the item actors. Read in rzx-r3 (all 288 bytes) and s3-right (64).
$EA20 ItemIconKind6
$EA40 ItemIconKind9
$EA60 ItemIconKind3
$EA80 ItemIconKind7
$EAA0 ItemIconKind5
$EAC0 ItemIconKind0 ; an empty box
$EAE0 ItemIconKind8
$EB00 ItemIconKind1
@res stage3/bitmaps-item-icons-2x16.bin
$EB20 b DriftShotSprites 3 ; The drifting shots: 4 frames of 3 bytes x 13 lines (the frame words at $B4B9)
> Read in s3-right (78 of 156 bytes); not in rzx-r3.
$EB47 DriftShot1
$EB6E DriftShot2
$EB95 DriftShot3
@res stage3/bitmaps-drift-shots-3x13.bin
$EBBC b HeroLeapSprites 8 ; The hero's leaps (back and up): 14 frames
> Read in rzx-r3 (434 of 765 bytes); not in s3-right.
$EE65 HeroLeapFrameTable ; 14 records
@res stage3/sprites-hero-leap.bin
$EEB9 b ParticleGlyphs 8 ; The burst's 4 particle glyphs, 1 byte x 8 lines each (UpdateBurst: BurstGlyphs[...] x 8 + $EEB9)
> Read in rzx-r3 (all 32 bytes).
@res stage3/bitmaps-particles-1x8.bin
$EED9 b BurstGlyphs 16 ; The glyph (0-3) of each burst step, indexed by the step + a random 0-3 (35 bytes)
> Read in rzx-r3 (31 of 35 bytes).
@res stage3/table-burst-glyphs.bin
$EEFC b BurstDirections 16 ; 6 rows of 32 indices into the burst's step table: each particle direction's step at each burst step
> Read in rzx-r3 (177 of 192 bytes).
@res stage3/table-burst-directions.bin
$EFBC b BurstShapes 2 ; The shapes a burst breaks up: 62 bytes, 2 bytes a line; each start reads 2 x 12 lines from its address
> The shapes are read from $EFBC ($A064), $EFCA ($9FEF: 14 bytes on, overlapping the first's zero tail) and $EFE2 (the dragon's and the figure's last hits, $A01E, $A039). Read in rzx-r3 (all 62 bytes).
$EFCA BurstShape2 ; the second shape
$EFE2 BurstShapeBoss ; the bosses' shape
@res stage3/bitmaps-burst-shapes-2x31.bin
$EFFA s BlockEnd ; 69 zero bytes to the block's end ($F03E) that no code reads (rzx-r3, s3-right; known only from the code)
