$8E27 IntroLine3 ; "VOID OF SPACE."
$8E39 IntroLine4 ; "PRAPARE TO" (sic)
$8E47 IntroLine5 ; "CONFRONT THE"
$8E57 IntroLine6 ; "EVIL ANGEL OF"
$8E68 IntroLine7 ; "TIME.DAMERON."
