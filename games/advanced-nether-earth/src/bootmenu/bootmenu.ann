$D781 b ProductionPage4 ; 4: a released robot does nothing until programmed
@res text/production.bin
$D807 b ElectronicsPage ; "Характеристика компонентов": electronics
@res text/components.bin
$DA3A b BombPage ; the A-bomb
@res text/components.bin
$DBA7 b PhasersPage ; phasers
@res text/components.bin
$DC6F b MissilesPage ; missiles
@res text/components.bin
$DD9A b CannonsPage ; cannons
@res text/components.bin
$DE83 b AntigravPage ; anti-gravs
@res text/components.bin
$DF6C b TracksPage ; tracks
@res text/components.bin
$E097 b BipodsPage ; bipods
@res text/components.bin
$E204 b ProgrammingPage1 ; "Программирование роботов" 1: landing on a robot, the combat mode, direct control
@res text/programming.bin
$E4FD b ProgrammingPage2 ; 2: giving an order, leaving the robot
@res text/programming.bin
