# The annotations of the boot code: the disk's sectors 1:1 and 1:2, which basic.asm's BootLoader reads to $5D3B
# (over the BASIC program) and returns into. The single source of src/disk/boot/*.asm (tools/part_mkasm.py,
# kit/mkgame.py's pipeline). The format is kit/mkgame.py's class Annotations, plus @const (tools/part_mkasm.py).
#
# The code is what the recording work/stage2/r1 ran (the boot, the menu, a game), widened by mkgame's walk.

@equ $2090 TRDOS_READ_SECTOR ; TR-DOS ROM: the read-sector command ($80) to the FDC and its data loop (BC = $017F: port $7F)
@equ $2A53 TRDOS_OUT_C ; TR-DOS ROM: OUT (C),A; RET, the gadget for writing an FDC or system register
@equ $2F59 TRDOS_WAIT_INTRQ ; TR-DOS ROM: wait for the FDC's INTRQ (port $FF bit 7), the end of a command
@equ $3D13 TRDOS_ENTRY ; the TR-DOS ROM's entry for machine code: C = the function (5: read B sectors from D:E to HL)
@equ $3D2F TRDOS_CALL ; a RET in the TR-DOS ROM: the address pushed before the JP here runs with TR-DOS paged in
@equ $5B5C BANKM ; the 128 system variable: the last value written to port $7FFD
@equ $5C3A ERR_NR ; IY's base for the ROM's system variables
@equ $5C3E ERR_SP_HIGH ; the high byte of ERR_SP
@equ $5C48 BORDCR ; the border colour and the lower screen's attribute
@equ $5C8D ATTR_P ; the permanent attribute
@equ $5CD6 TRDOS_ERRORS ; TR-DOS: the count the ROM's read routine raises on a failed sector (compared around each read)
@equ $5CF4 TRDOS_SECTOR 2 ; TR-DOS: the sector and track after the last one read
@equ $5D10 TRDOS_5D10 ; a TR-DOS work byte zeroed before each read (as basic.asm's loader does)
@equ $5D16 TRDOS_SYSREG ; TR-DOS's copy of the system register (port $FF: drive, side, density)
@equ $5800 Attrs 768 ; the attribute file
@equ $607C Block4 ; Trush block 4's load address: it unpacks the installer, the GS driver file and Zynaps to $61A8-$FFFF
@equ $61A8 Install ; the installer (src/disk/install.asm): the stubs, the patches, the driver to bank 1, Zynaps started
@equ $6D60 OptionsMenu ; the options menu, run in place inside the unpacked driver file (src/disk/menu.ann)
@equ $7E2C Block0 ; Trush block 0's load address: it unpacks the loading screen and its fade to $7F58-$9AFF
@equ $7F58 ShowLoadingScreen ; the loading screen's fade-in (src/disk/screen.ann)
@equ $8000 LoadingScreen 6912 ; the loading screen as block 0 unpacks it
@equ $BED4 PackedAt ; where the Trush blocks of banks 4 and 6 load: base $BED4, unpacked to $C000-$FFFF
@equ $C000 Bank 16384 ; the paged bank
@equ $D29F Block1 ; Trush block 1's load address: it unpacks bank 1's sound data to $D3CB-$FFFF
@const PAGE_ROM48 $10 ; port $7FFD values: bit 4 the 48 BASIC ROM, bits 0-2 the bank at $C000 (here bank 0)
@const PAGE_BANK1 $11
@const PAGE_BANK3 $13
@const PAGE_BANK4 $14
@const PAGE_BANK6 $16
@const PAGE_BANK7 $17

@module boot ; the boot: the loading screen, the sound banks, the game block, the options menu
@about BootLoader (src/disk/basic.asm) reads these two sectors to $5D3B and returns into Start. Every block is read with ReadSectors from where the last read stopped (TR-DOS's TRDOS_SECTOR): the disk is one run of sectors in the order Start reads them, then the level data the loader finds by the record table (src/disk/loader.ann).
@about The sound data the card gets at the game start goes to the 128's banks 1, 3, 4 and 6 first (bank 1 from $D3CB; the GS driver will be put below it at $C000). Banks 1, 4 and 6 come as Trush blocks (src/disk/trush.asm) that unpack themselves at their load address and return; bank 3 is read as it is. Bank 7 keeps a copy of the loading screen for the loader to show while a level's music loads.
@about Holding ENTER while the disk boots selects the boot's own sector reader (FastRead): TR-DOS's read routines without its function 5's checks, a track at a time. Without ENTER every block is read with TR-DOS's function 5.
$5D3B c Start ; the boot: screen black, the loading screen, the sound banks, block 4, the menu, the installer
> Entered by RET from BootLoader with the two sectors in place. SP goes below block 4's load address. The order on the disk is the order here: block 0 (13 sectors, the loading screen), block 1 (40, bank 1), bank 3 (64 sectors, raw), block 2 (58, bank 4), block 3 (49, bank 6), block 4 (94: the installer, the GS driver file, the options menu and Zynaps).
> After the fade the options menu runs in place (OptionsMenu, inside block 4's driver file) and sets its choices into the not yet installed code; then JP Install.
$5D3F ; A = 0 (ClearScreen)
$5D4C ; the stack below block 4
$5D4F ; block 0: 13 sectors to $7E2C, run (it unpacks the loading screen and returns)
@isub $5D52 LD BC,13*256+PAGE_BANK7
$5D58 ; the loading screen to bank 7 (paged by the read) for the loader's level breaks
$5D63 ; the loading screen's fade-in
$5D66 ; block 1: 40 sectors to $D29F in bank 1: bank 1's sound data from $D3CB
@isub $5D69 LD BC,40*256+PAGE_BANK1
$5D6F ; bank 3: 64 sectors as they are
@isub $5D72 LD BC,64*256+PAGE_BANK3
$5D78 ; block 2: 58 sectors to $BED4 in bank 4
@isub $5D78 LD BC,58*256+PAGE_BANK4
$5D7E ; block 3: 49 sectors to $BED4 in bank 6
@isub $5D7E LD BC,49*256+PAGE_BANK6
$5D84 ; block 4: 94 sectors to $607C with the 48 ROM and bank 0: $61A8-$FFFF
@isub $5D87 LD BC,94*256+PAGE_ROM48
$5D8D ; the loading screen fades out
$5D90 ; the options menu (it returns with bank 0 paged)
$5D96 c ReadPackedAt ; B sectors to PackedAt ($BED4) in the bank C pages, then run them (a Trush block)
$5D99 c ReadAndRun ; B sectors to HL with port $7FFD = C, then JP (HL): the block unpacks itself and returns to the caller
$5D9F c FadeOut ; the screen's attributes darkened in 7 steps of 8 frames, then the screen cleared (ClearScreen)
> Each step takes 1 from every cell's ink and paper (down to 0) and keeps BRIGHT; FLASH is dropped. The loop falls into ClearScreen.
$5DC9 ; 8 frames
$5DCF c ClearScreen ; border black, the bitmap and the attributes zeroed (LDDR down from $5AFF), A = 0
$5DDF c ReadSectors ; B sectors from TRDOS_SECTOR to HL, with C written to port $7FFD (and BANKM) first
> Port $7FFD is written before the read, so the sectors go to the bank C selects when HL is at $C000 or above. With ENTER up (port $BFFE bit 0 set) the read is TR-DOS's function 5 through TRDOS_ENTRY, which returns to the caller; with ENTER held the boot reads the sectors itself (FastRead) and keeps TRDOS_SECTOR up to date as function 5 does.
$5DF5 ; ENTER?
$5DFF c FastRead ; ENTER held: B sectors from D:E with TR-DOS's own FDC routines, each retried until it reads without error
> SeekTrack selects the side and steps to track D >> 1 (bit 0 of D is the side). Each sector: ReadSector, and TRDOS_ERRORS compared with its value before the read; a change means the read failed and it is read again. Past sector 15 the next track is sought. The position after the last sector goes back to TRDOS_SECTOR.
$5E0D ; one sector: TRDOS_ERRORS before
$5E23 ; read: the next sector, the next track after 16
$5E31 ; 256 bytes on
$5E3D c ReadSector ; sector E + 1 to the FDC's sector register, then TR-DOS's read-sector code with BC = $017F (data port)
> The LD BC pushes this routine's own address before the jumps into the ROM: a word the ROM code takes from the stack on its way out.
$5E51 c SeekTrack ; drive side from D bit 0 (system register), track D >> 1 to the data register, the seek command ($18)
$5E6D c WriteFdc ; A to the port C through TRDOS_OUT_C
$5E71 c RomCall ; IX run inside the TR-DOS ROM (PUSH IX; JP TRDOS_CALL)
$5E76 s Spare ; zeros to the end of the second sector
