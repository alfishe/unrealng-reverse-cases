# The annotations of the game image: the single source of truth for src/game/*.asm (kit/mkgame.py).
# The format is in kit/mkgame.py, class Annotations. One line an entry:
#
#   @module NAME ; title            the entries from here on go to NAME.asm, the title heads the file
#   @about a paragraph              the module file's header text, one paragraph a line
#   $ADDR c Name ; title            a routine
#   > a description line
#   $ADDR b Name ; title            data (w words, t text, s space; "b Name 8" rows of 8)
#   @res graphics/NAME.bin          the entry is a resource: src/res/..., INCBIN
#   $ADDR Name ; comment            a label and comment inside an entry: on an instruction, or on the data line
#                                   that starts at ADDR (a data entry's rows are cut there)
#   @isub $ADDR LD HL,-6            the instruction written so
#   @equ $ADDR Name [N] ; comment    a variable past the image: an EQU, its operands by name
#   @inline $ADDR                   a routine that reads its data after the CALL
@equ $4000 Screen 6144 ; the screen's pixels
@equ $5800 Attributes 768 ; the screen's attributes
@equ $5B01 RoomObjectList 32 ; the room's item records then its enemy records (2 bytes each), copied by SetupRoomObjects
@equ $5B50 ColumnValues 48 at $8BC5,$8C1D ; one picture column unpacked to 3-bit values (UnpackColumn $8BC5)
@isub $836E LD BC,PrintGlyphTop+10
@isub $837B LD BC,Font
@isub $87C8 LD HL,HavokPicture+383
@isub $887A LD DE,$F000
@isub $8B60 LD DE,$FFFF
@isub $8DFE LD SP,$5C00
@isub $8E5E LD DE,$A001
@isub $8E98 LD DE,$C030
@isub $A7B6 LD DE,$A001
@isub $8F0E LD A,(Hiro+$001B)
@isub $92AA LD A,(Hiro+$001B)
@isub $92CA LD A,(Hiro+$001B)
@isub $956A LD A,(Hiro+$0020)
@isub $97BF LD HL,Hiro+$001C
@isub $A570 LD A,(Hiro+$001B)
@isub $8902 LD DE,$5D4A
@isub $8F65 LD DE,$5D4A
@isub $9087 LD A,(Hiro+$002A)
@isub $936B LD A,(Hiro+$002A)
@isub $96B1 LD DE,(Hiro+$002A)
@isub $96B5 LD BC,(Hiro+$002C)
@isub $96E2 LD (Hiro+$002A),DE
@isub $96E6 LD (Hiro+$002C),BC
@isub $9808 LD A,(Hiro+$0034)
@isub $980D LD DE,Hiro+$002C
@isub $988D LD HL,Hiro+$0030
@isub $98A7 LD HL,Hiro+$0010


@over $5FC0 ; SetTune: built at run time from the template ($6C96); the image holds the intro script here
@over $5FCB ; HavokRoomLeave: run-time code from the template
@over $5FD4 ; HavokRoomEnter: run-time code from the template
@over $65EE ; TitleWhiteRows: run-time code from the template ($6FB8)
@over $6682 ; PauseGame: run-time code from the template ($6FCA)
@over $66B6 ; PendingMessage: run-time code from the template
@over $66BD ; RunBanner: run-time code from the template
@over $66C8 ; ShowMessage: run-time code from the template

@var $5D00 Hiro 66 ; Hiro's actor page (+$00-$41), over GameEntry's code once the game runs
@var $5DF8 WeaponDefaultItem ; run time: the item record of the default weapon (page tail of $5D00, from the template)
@var $5FC0 SetTune ; run time: tune command, and the Havok room stash
@var $5FCB HavokRoomLeave ; run time: put back the stashed blocks on leaving room 123
@var $5FD4 HavokRoomEnter ; run time: stash two blocks on entering room 123
@var $6082 SizeClasses ; run time: the size classes (page tail of $6000)
@var $64EE WeaponTemplate 18 ; run time: the thrown weapon's template, patched per weapon kind
@var $6500 ActorPage9 66 ; the ninth actor page
@var $65B8 SharedEnemyTemplate 18 ; run time: an actor template
@var $65CA HiroTemplate 18 ; run time: Hiro's actor template
@var $65DC TitlePieceTemplate 18 ; run time: the title pieces' template
@var $65EE TitleWhiteRows ; run time: fill the attribute rows $59E0-$5ADF with white ink
@var $6600 WeaponActor 66 ; the tenth actor page: Hiro's thrown weapon, and the message banner
@var $6642 Vitality ; Hiro's energy, 0-$20
@var $6643 VitalityShown ; the energy the meter shows
@var $6644 ChargeStep ; the charge added a tick while fire is held
@var $6645 Charge ; the strike charge, 0-$20
@var $6646 ChargeShown ; the charge the meter shows
@var $6647 ChargeReset ; the charge after a strike
@var $6648 FirePrevious ; the fire bit of the last tick (initial value from the control menu)
@var $6649 WeaponCount ; throws left of the picked-up weapon (16)
@var $664A WeaponCountShown ; the count the weapon bar shows
@var $664B Weapon ; the weapon kind (0 = the default)
@var $664C PauseFlag ; bit 7: P pressed (the tick sets it)
@var $664D Lives ; lives, BCD
@var $664E Fragments ; Fireblade fragments found (bit 4: all 16)
@var $664F FragmentsShown ; the count the panel shows
@var $6650 FireRequest ; the strike level of the pending move (1-3)
@var $6651 Invulnerable ; set while the energy ball runs (the actor at $6500)
@var $6652 EndFlags ; bit 6: Havok dead, waiting for fire; bit 7: the end
@var $6653 Score 4 ; the score, 8 BCD digits
@var $6657 ScoreLine 16 ; the score line's text record: Y, X, style, style, 8 digits, skip 7, 2 lives digits, end
@var $665B ScoreDigits 8 ; the score's digits in ScoreLine
@var $6664 LivesDigits 2 ; the lives' digits in ScoreLine
@var $6667 StatusLine 19 ; the status line's text record: EXTRA, the weapon bar, BONUS
@var $6671 WeaponIcon 2 ; the weapon icon's two glyph codes in StatusLine
@var $6682 PauseGame ; run time: the pause (and quit) from the main loop
@var $66B6 PendingMessage ; run time: show message A, then run the banner out
@var $66BD RunBanner ; run time: update the banner actor until it ends
@var $66C8 ShowMessage ; run time: show banner message A and wait for it
@var $66FA TitleColours ; run time: the title's colours (page tail of $6600)
@var $68DC EnemySlots 16 ; the room's enemy slots (spare cells of plane $6800)
@var $69DC HiroFallScript ; spare cells of plane $6900
@var $69DD BoxClip
@var $69DF MapRow ; Hiro's map position: the row (0-$13)
@var $69E0 MapColumn ; Hiro's map position: the column
@var $69E1 Strike
@var $69E3 FireHeld
@var $6ADC ItemCount ; spare cells of plane $6A00: the room's objects
@var $6ADD EnemyCount
@var $6ADE EnemyListPtr 2
@var $6AE0 ZoneCount
@var $6AE1 ZoneRecords 12
@var $6BDC RoomAbove ; spare cells of plane $6B00: the room
@var $6BDD Room ; the room number, 1-127 (Havok's 123)
@var $6BDF StripStep
@var $6BE0 BackWallSet
@var $6BE1 FillRowStart
@var $6BE2 FillStopCell
@var $6BE3 CellProperty
@var $6D00 HavokStashB 144 ; $80EB's 144 bytes while Hiro is in room 123
@var $6DFE TakenItems
@var $6DFF RevealedZones
@var $6E00 HavokStashA 96 ; $7F1D's 96 bytes while Hiro is in room 123
@var $6EFE GoneEnemies 2
@var $6F00 OutlineMask 256 ; built by GameEntry: 256 bytes of NOT (a OR a<<1 OR a>>1)
@var $7000 RowBase 12 ; built by GameEntry: the first cell of each row, 0, 20 ... 220
@var $700C NameBoxPlaces 60 ; built by GameEntry: 5 x 6 screen places (E, D)

@module setup ; The start code, the entry, the start of play, a new game and a new life
@about The game is entered at GameEntry $5CFA (the bootstrap's JP on both machines): the control menu, the 48K intro, then the page tails: ten 126-byte rows of PageTailTemplate ($6B5C) go to +$82..+$FF of the pages $5D00-$6600 (the actor kind templates, the size classes, the touch zones and some run-time code), then the tables OutlineMask $6F00, RowBase $7000 and NameBoxPlaces $700C, and the room cells are cleared. From then on GameEntry's own bytes ($5D00 on) are Hiro's actor page.
@about NewGame $5C4D is the title loop and the start of every game: the title and high-score table ($A73E), the cheat name check (a high-score name SLOPPY lets keys 1-4 choose the start room), the 128K intro hook, the globals from GlobalsInit, Hiro's actor, the first room, then the main loop $8DFE. GameOver $5C42 and EndOfGame $5C45 lead back to it.
$5C00 b GlobalsInit 10 ; The globals' start values: 56 bytes copied to Vitality $6642 at a new game
> NewGame `$5CA9` copies these 56 bytes (LDIR, BC = `$38`) to `$6642-$6679`; the first 10 (7 when a boss kind is set, `$9A59`) are copied again when a life is lost (LoseEnergy `$9615`).
> Each shown copy (`$6643`, `$6646`, `$664A`, `$664F`) starts unequal to its value, so the first pass of the panel jobs ($FF01, $FF64) draws everything. The byte `$5C06` (FirePrevious) is written by ControlMenu `$6A9E` with the chosen fire mask.
> Two text records follow (for `$837B`): the score line (Y, X, two style bytes, eight digits "00000000", a skip of 7 cells, the lives "05", end) and the status line at Y `$B8` X `$12` (style `$FF` `$FF`: "EXTRA", glyph `$85`, the weapon icon `$5B` `$5C`, glyph `$86`, "BONUS", end); glyphs `$85`/`$86` are the weapon bar (`$7F0D`).
$5C00 ; Vitality $20, shown $1F; ChargeStep 1, Charge 0, shown 1; ChargeReset 0; FirePrevious 1 (patched); WeaponCount 0, shown 1; Weapon 0
$5C0A ; PauseFlag 0, Lives $05, Fragments 0, shown 1, FireRequest, Invulnerable, EndFlags 0, Score 0 (4 bytes)
@res tables/start-values.bin
$5C15 b ScoreLineInit 4 ; The rest of GlobalsInit: the score line and the status line, two text records for $837B (to ScoreLine $6657, StatusLine $6667)
> Copied with GlobalsInit by NewGame; the panel draws them at run time from `$6657` and `$6667` (texts/panel.txt).
$5C15 ; ScoreLine: Y 0, X 0, style $07 $47
$5C19 ; the eight score digits
$5C21 ; skip 7 cells, the lives' digits "05", end
$5C25 StatusLineInit ; StatusLine: Y $B8, X $12, style $FF $FF
$5C29 ; "EXTRA", glyph $85, the weapon icon $5B $5C, glyph $86, "BONUS", end
@res texts/panel.bin
$5C38 b ExtraBonusUnlit 5 ; The attribute of an unlit EXTRA / BONUS letter ($42), five times
> Read by the letter check `$999F-$99CE`: when the five EXTRA letters (attributes `$5AE9`) match ExtraBonusLit they are reset from here and a life is added (message 1); the BONUS letters (`$5AF2`) give message 2 and a score bonus.
@res graphics/letter-attrs.bin
$5C3D b ExtraBonusLit 5 ; The attribute of a lit EXTRA / BONUS letter ($47), five times
> The compare string for the letter check `$999F`.
@res graphics/letter-attrs.bin
$5C42 c GameOver ; The game is lost: the GAME OVER banner, then the high-score entry and the title
> From LoseEnergy `$9651` (`JP M` when the lives run out). CALL `$831A`: ShowMessage `$66C8` with A = 4 (GAME OVER) and a wait of up to 40 x 5 frames or fire. Falls into EndOfGame.
> Witness: L1 6 (gameover, hiscore, rzx x4). Ran once in gameover.
$5C45 EndOfGame ; from $8E12 too (EndFlags bit 7, after Havok): tune $FF, the high-score entry $A806
$5C4D c NewGame ; The title loop and a new game: title, cheat, globals, Hiro, the first room, the main loop
> 1. SetTune `$5FC0` with A = `$80` (the title tune); the title sequence and high-score table `$A73E` returns when fire is pressed.
> 2. The cheat: MatchCheatName `$5C68` compares each of the ten high-score names (`$8126`, 21-byte records) with "SLOPPY    " (`$8214`). On a match the keys 1-4 (`$F7FE`) held then pick the start: 1 = row `$06` column `$0D`, 2 = `$09`/`$12`, 3 = `$0F`/`$0E`, 4 = `$0F`/`$14`; else (and without the name) row 0 column 3 (room 4). The pair goes to MapRow `$69DF` / MapColumn `$69E0`.
> 3. `$5C9A`: three NOPs on a 48K; on a 128K the bootstrap writes `CALL $85C5` here (the 128K intro with music, bank 4 `$D3D0`).
> 4. Clears `$6D00-$6EFF` (HavokStashB, TakenItems, RevealedZones, HavokStashA, GoneEnemies), copies GlobalsInit to `$6642`, sets the six bytes `$76D8` to 1.
> 5. SpawnActor `$A65D` for Hiro (page `$5D00`, kind `$24`, template `$65CA`, BC = `$4804`); Hiro +`$02` = 7; `$88AE` = 0; CLS (`$8339`); tune command 2 (`$8452`).
> 6. The first room: IY = Hiro, `$95C3` (the map lookup and build), `$8365` (the score line), PanelAttrs `$FFEB` (Z in room 4: the attributes `$46`, else 7, through `$835A`), then the tick on (`$845F` = 0) and `JP $8DFE`, the main loop.
> Witness: L1 20 (deaths, gameover, havok, hiscore, menu, throw, c x2, opt x3, rzx x2, rzxroom x1).
$5C55 TitleFired ; the ten high-score names: is one of them SLOPPY?
$5C5B NewGameNameLoop
$5C66 ; no name matched: the normal start
$5C68 c MatchCheatName ; Compare 10 bytes at HL with the cheat name $8214 ("SLOPPY    "); on a match choose the start room by the keys 1-4
> HL = a high-score name. DE runs from `$8213` (pre-incremented), BC = 10 with CPI: a byte that differs returns NZ (BC as left). After ten equal bytes it does not return: it reads `$F7FE` (keys 1-5) and jumps into NewGame at `$5C96` with the start pair (C = row, B = column), so the rest of the name loop's stack (BC) is left behind; NewGame never returns, so the extra word does not matter.
> Witness: L1 150 (deaths, gameover, havok, hiscore, menu, play48, throw, c x1, opt x3, rzx x1, rzxroom x1). The key branch is known only from the code (no keyed recording has SLOPPY in the table).
$5C6D MatchCheatNameLoop
$5C76 ; a match: the key held picks the start
$5C93 NewGameStart ; row 0, column 3: room 4
$5C96 NewGameSetStart ; MapRow, MapColumn
$5C9A ; the 128K hook: CALL $85C5 (the 128K intro) is written over these three NOPs
$5C9D ; clear $6D00-$6EFF
$5CA9 ; the globals from GlobalsInit
$5CB4 ; six flags $76D8 = 1
$5CB9 NewGameFlagsLoop
$5CBE ; Hiro: SpawnActor $A65D, kind $24, template $65CA
$5CDD ; the first room
$5CF0 NewGameColour ; the play window's attributes: $46 in room 4, else 7
$5CF3 ; the tick on, the main loop
$5CFA c GameEntry ; The game's entry: the control menu, the intro, the page tails and tables, then NewGame
> Jumped to by the bootstrap (`JP Z,$5CFA` at `$4054` on a 48K, `JP $5CFA` at `$4092` on a 128K). ControlMenu `$6A7B`; then GameEntryIntro `$5CFD`.
> Witness: L1 2 (c x2).
$5CFD c GameEntryIntro ; CALL Intro48 (the 128K bootstrap writes three NOPs over it), then build the page tails
> `CALL $5D4F` (Intro48); a 128K bootstrap overwrites these three bytes with `00 00 00` (its intro runs in NewGame instead). Then A = 10 rows, HL = PageTailTemplate `$6B5C`, D = `$5D` and BuildPageTails `$5D07`.
> An entry of its own: the address is a routine entry of the tape loader's BASIC code in the recordings.
> Witness: L1 11 (deaths, gameover, hiscore, menu, throw, c x2, opt x3, rzx x1).
$5D07 c BuildPageTails ; Ten rows of 126 bytes from the template to +$82..+$FF of the pages $5D-$66, then the tables
> Each pass: BC = `$7E`, E = `$82`, LDIR (which leaves D one higher, the next page). Then:
> - OutlineMask `$6F00`: for a = 0..255, NOT (a OR a<<1 OR a>>1) (the pixels next to none of a's), the mask for drawing a sprite's dark outline (`$8C0A`, `$8C0F`, `$8CAD`, `$A4D1`);
> - RowBase `$7000`: 0, 20 ... 220, the first cell of each of the 12 rows (`$8EB5`, `$8F75`);
> - NameBoxPlaces `$700C`: 5 rows x 6 words (E = `$34` + `$10` row, D = `$12` + 4 column), the screen places of the name entry's letter boxes;
> - ClearRoomCells `$70EF` with C = `$DC`, B = `$24`: the cells `$DC-$FF` of the six planes (the spare cells and the row above) are cleared; `JP $5C4D` (NewGame).
> An entry of its own: `$5D07` is also the BASIC line's code (the tape loader), so the recordings mark a routine entry here.
> Witness: L1 122 (deaths, gameover, hiscore, menu, throw, c x2, opt x3, rzx x1, rzxroom x1).
$5D11 ; OutlineMask $6F00
$5D14 BuildOutlineMaskLoop
$5D24 ; RowBase $7000: 12 rows of 20 cells
$5D26 BuildRowBaseLoop
$5D2C ; NameBoxPlaces $700C: 5 rows of 6
$5D31 BuildBoxRowLoop
$5D34 BuildBoxPlaceLoop
$5D46 ; clear the room cells $DC-$FF of the six planes

@module menu ; Title, menu, options, keys, the high-score table and its entry
@about Intro48 $5D4F is the 48K version's intro (the 128K one is in bank 4, `$D3D0`): a script of pictures built from IntroGlyphs (237 eight-byte glyphs at $6313) and texts in the game font, boxed, with attribute blocks and a border flash. It repeats until fire is pressed. GameEntry calls it once, before the page tails are copied over its code.
$5D4F c Intro48 ; The 48K intro: five scenes from IntroScript, looping until fire is pressed
> Run only on a 48K (the 128K bootstrap removes the call at `$5CFD`). IY walks IntroScript `$5E4D` record by record:
> 1. CLS (`$8339` with A = 7); box (`$3090`, 8 x 5) round the eyes picture `$5E4D`, the text `$5E64` (FOR 10000 YEARS HE SLEPT ...), the text `$5EB5` (NOW HE HAS AWAKENED), the eye frames `$5F06`, `$5F10` (attribute `$42` at `$5A9C`), `$5F1A`, each with a wait of 1 x 5 frames, then 40 x 5 frames.
> 2. CLS; the attribute block IntroAttrsA `$6225` at `$5882` (5 rows of 3); box (`$0008`, 19 x 7) round the picture `$5F24` and the text `$5F56` (THE FIREBLADE SHATTERED ...); border white, IntroAttrsB `$6234`, a delay `$2000`, border black; the picture `$5FA0` and the text `$5FD2` (THEN THE SLAUGHTER BEGAN.).
> 3. CLS; IntroAttrsC `$6243` at `$5828` (13 rows of 16); box (`$0F00`, 18 x 15) round Havok's picture `$601E` (220 glyphs) and the text `$60FD` (NOW HAVOK REIGNS THE UNDERCITY.); the text `$6161` (I AM HIRO ...); a wait of 60 x 5 frames.
> The waits `$831F`/`$8321` return Z when fire (`$8529`) is pressed: then it returns; else it starts again.
> Witness: L1 3 (c x1, rzx x1). Ran only in c48.
$5D6A ; the second eye frame lit
$5D75 ; scene 2: the Fireblade
$5DAC ; scene 3: Havok and Hiro
$5DC9 IntroHold ; 60 x 5 frames, then again unless fire
$5DD2 c IntroScene ; A box, then the next picture and text of the script
> DE = the box's screen place, BC = its size: IntroBox `$5DFB`, then IntroPictureText.
> Witness: L1 9 (c x1, rzx x1). Ran only in c48.
$5DD5 c IntroPictureText ; The next picture and text of the script, then a wait of 40 x 5 frames
> Witness: L1 12 (c x1, rzx x1). Ran only in c48.
$5DD8 c IntroText ; The next text record of the script, then a wait of 40 x 5 frames ($831F)
> Witness: L1 15 (c x1, rzx x1). Ran only in c48.
$5DDE c IntroPictureWait ; The next picture record, then a wait of 1 x 5 frames
> H = 1 and `$8321`: the eye frames' step.
> Witness: L1 9 (c x1, rzx x1). Ran only in c48.
$5DE6 c IntroPicture ; Draw the picture record at IY with IntroGlyphs; IY to the next record
> HL = IY, BC = IntroGlyphs `$6313`, PrintGlyphs `$61E5`.
> Witness: L1 21 (c x1, rzx x1). Ran only in c48.
$5DF1 c IntroPrint ; Print the text record at IY ($837B); IY to the next record
> Witness: L1 18 (c x1, rzx x1). Ran only in c48.
$5DF7 c IntroScriptNext ; IY = HL, the record after the one just drawn
> Witness: L1 39 (c x1, rzx x1). Ran only in c48.
$5DFB c IntroBox ; Build a box of the font's frame glyphs as a text record at $5B01 and print it
> DE = Y, X; B = the width, C = the height (in cells). The record: Y, X, style `$06` `$06`, the top row (`$22`, `$23` x (B-2), `$24`), `$FF`, C-2 side rows (`$25`, a skip of B-2 cells, `$25`, `$FF`), the bottom row (`$27`, `$28` x (B-2), `$29`), end; then `$837B` prints it.
> Witness: L1 9 (c x1, rzx x1). Ran only in c48.
$5E1A IntroBoxSides
$5E34 c IntroBoxRow ; Store E, then B-2 times A, then D at HL (a box's top or bottom row)
> Witness: L1 18 (c x1, rzx x1). Ran only in c48.
$5E38 IntroBoxRowLoop
$5E3F c IntroBoxSide ; Store a box side row at HL: $25, a skip of B-2 cells, $25, $FF
> A code below `$20` in a text record skips that many cells (`$837B`).
> Witness: L1 99 (c x1, rzx x1). Ran only in c48.
$5E4D b IntroScript ; The 48K intro's script: 8 pictures and 7 texts in the order Intro48 draws them
> A picture: Y, X (pixels / 2), glyph numbers (1-`$ED`, into IntroGlyphs), `$FF` a new line, 0 the end. A text: Y, X, two style bytes, the characters (font `$7BE5`), `$FF` a new line, 0 the end (the record of `$837B`).
> Its bytes are under the page tails of `$5D00-$6100` at run time (GameEntry copies the template over them after the intro): the labels in here from `$5FC0` on name those run-time contents.
$5E4D ; picture: the eyes (20 glyphs)
$5E64 ; FOR 10000 YEARS HE SLEPT. / HIS MIND FEEDING... / ON THE NIGHTMARES OF THE WEAK.
$5EB5 ; NOW HE HAS AWAKENED
$5F06 ; picture: the eyes open, frame 1
$5F10 ; frame 2
$5F1A ; frame 3
$5F24 ; picture: the Fireblade (47 glyphs)
$5F56 ; AS THE NIGHT BLED CRIMSON / THE FIREBLADE SHATTERED / AND ITS POWER DIED.
$5FA0 ; picture: the shattered Fireblade (47 glyphs)
$5FD2 ; THEN THE SLAUGHTER BEGAN.
$601E ; picture: Havok (220 glyphs)
$60FD ; THEY NEVER / THOUGHT HE WOULD RETURN. / NOW HAVOK REIGNS THE UNDERCITY.
$6161 ; I AM HIRO, / THE LAST OF THE BLADEKNIGHTS. / I MUST REBUILD THE FIREBLADE, / AND BRING THE DAWN...
@res texts/intro.bin
$61E5 c PrintGlyphs ; Draw a picture record: B = Y, C = X, then glyph n at BC + 8(n-1), $FF a new line, 0 the end
> HL = the record, BC = the glyph set. The place is set by `$83CD`; each glyph is drawn by `$83F9` (8 bytes at BC + 8 (n-1)); `$FF` moves to the next line (`$83C6` holds the line start, `$83CD` again). Returns HL past the 0.
> The entries PrintGlyphsLoop to PrintGlyphsLine are split off because stage 2's code occupies these addresses while the tape loads, and the recordings mark routine entries there.
> Witness: L1 1141 (c x2, rzx x1). Ran only in c48.
$61F0 c PrintGlyphsLoop ; The next byte of the record
> Witness: L1 1086 (c x1, rzx x1).
$61F1 c PrintGlyphsNext ; 0 ends the record
> Witness: L1 1246 (c x2, rzx x1).
$61F5 c PrintGlyphsByte ; $FF: a new line; else the glyph's address
> Witness: L1 1227 (c x2, rzx x1).
$6200 c PrintGlyphsAddress ; HL = 8(n-1) + the glyph set; draw it ($83F9)
> Witness: L1 1122 (c x2, rzx x1).
$6205 c PrintGlyphsDone ; The glyph is drawn: the next byte
> Witness: L1 1065 (c x1, rzx x1).
$6206 c PrintGlyphsRestore ; POP BC, back to the loop
> Witness: L1 2295 (c x2, rzx x1).
$6209 PrintGlyphsNewLine ; BC = the line start $83C6
$620D c PrintGlyphsLine ; Set the print place to BC ($83CD), back to the loop
> Witness: L1 1347 (c x2, rzx x1).
$6212 c CopyAttrBlock ; Copy B rows of C bytes from HL to the attributes at DE (DE + 32 a row)
> From Intro48 (IntroAttrsA/B/C).
> Witness: L1 1299 (c x2, rzx x1). Ran only in c48.
$621F c CopyAttrBlockCarry ; The high byte of DE + 32
> Witness: L1 71 (c x2, rzx x1).
$6225 b IntroAttrsA 3 ; Intro scene 2's attributes: 5 rows of 3 bytes at $5882
@res graphics/intro-attrs.bin
$6234 b IntroAttrsB 3 ; Intro scene 2's attributes after the border flash: 5 rows of 3
@res graphics/intro-attrs.bin
$6243 b IntroAttrsC 16 ; Intro scene 3's attributes: 13 rows of 16 at $5828
@res graphics/intro-attrs.bin
$6313 b IntroGlyphs 8 ; The 48K intro's 237 glyphs (8 bytes each, glyph 1 first)
> Read by PrintGlyphs `$61E5` through IntroPicture (BC = `$6313`). A graphics resource (237 x 8 = 1896 bytes, to `$6A7A`).
> At run time these bytes are under the actor pages `$6300-$6600` (with their page tails, the globals at `$6642`) and the room planes `$6700-$6A7A`: the labels inside name those run-time contents (the rows are cut there).
@res graphics/intro-glyphs-1.bin
$66CD c GlyphBytesAsCode ; Not code: IntroGlyphs bytes that the kit must list as instructions
> These are bytes of IntroGlyphs (`$66CD-$66F6`, glyphs 120-125). At run time the page tail of `$6600` puts ShowMessage's `RRA` at `$66CD`, and the image holds the same byte `$1F` there, so the recordings count a ran instruction at this address and the disassembly goes on through the glyph bytes to `$66F6`. Nothing jumps here in the image.
> Witness: L1 13 (gameover, hiscore, menu, opt x3, rzx x5).
$66CE GlyphBytesTail ; the rest of the glyph bytes, as data
$66F7 b CellColours 8 ; IntroGlyphs continued; at run time $66F7-$66FF is the cell colour table (page tail of $6600)
> At run time (after BuildPageTails) the nine bytes are `07 47 46 07 46 05 47 06 45`: the render's `$88BA` takes the attribute of a revealed cell from here by the high nibble of its plane byte; TitleSequence `$A754` reads the last six (TitleColours `$66FA`) as the title's colours. In the image the entry is the rest of IntroGlyphs, to `$6A7A`.
@res graphics/intro-glyphs-2.bin
$6A7B c ControlMenu ; The control menu: keys 1-4 choose joystick 1, joystick 2, Kempston or Protek / cursor; patch the input code
> CLS (A = 0), print ControlMenuText `$6ACB` (`$836E`), wait for one of the keys 1-4 (`$F7FE`, read until one is held; key 1 first). HL = ControlRecords `$6B0A` + 14 x (key - 1); the record patches the input read:
> - +0 the fire mask, to `$84CA` and to FirePrevious's start value `$5C06`;
> - +1 the direction mask, to `$850F` and `$8511`;
> - +2 `RRA` or `NOP`, to `$8513`;
> - +3..+6 the opcodes `DEC E` / `INC E` / `INC D` / `DEC D` in the record's direction order, to `$851A`, `$851E`, `$8522`, `$8526`;
> - +7 on: 18 bytes of code copied to `$8529`, the fire test (Z when fire).
> Called from GameEntry once (the menu is not shown again).
> Witness: L1 2 (c x2). Ran in c1 and c48.
$6A88 ControlMenuWait
$6A91 c ControlMenuKey ; The next key (bit) of 1-4
> Witness: L1 9813588 (deaths, gameover, hiscore, menu, throw, c x2, opt x3, rzx x1).
$6A95 ControlMenuNext ; the next key bit (a return point of the key test)
$6A99 ControlMenuPatch ; HL = the chosen record
$6AC2 ; the fire test code
$6ACB b ControlMenuText ; The control menu as a text record ($836E): Y $34, X $0E, style $07 $47, four lines
$6ACF ; 1.JOYSTICK 1 / 2.JOYSTICK 2 / 3.KEMPSTON / 4.PROTEK OR CURSOR, end
@res texts/control-menu.bin
$6B0A b ControlRecords 7 ; The four control records (14 bytes): fire mask, direction mask, RRA/NOP, four direction opcodes, the fire test
> Keys 1 and 2 are the Sinclair joysticks (keys 6-0, fire 0; keys 1-5, fire 5), 3 the Kempston port `$1F` (bits inverted by CPL, so the `RRA` slot is a `NOP`), 4 the Protek / cursor keys 5-8 and 0: key 5 is rotated into bit 1 and ANDed with the `$EFFE` row, so key 5 and key 9 both give left; fire is key 0 only.
> The last record's fire test is 18 bytes (`$6B3B-$6B4C`); the others' 7 bytes are followed by the next record (18 bytes are always copied: records 1-3 bring 11 bytes of the next record after their `RET`; record 4 runs into `$6B42`-`$6B4C`). The cursor test reads `$F7FE` (key 5) and `$EFFE` and ANDs them, but only bit 0 (key 0) is tested.
$6B0A ; 1: Sinclair 1 (row $EFFE)
$6B11 ; LD A,$EF; IN A,($FE); BIT 0,A; RET
$6B18 ; 2: Sinclair 2 (row $F7FE)
$6B1F ; LD A,$F7; IN A,($FE); BIT 4,A; RET
$6B26 ; 3: Kempston
$6B2D ; IN A,($1F); CPL; BIT 4,A; RET; NOP
$6B34 ; 4: Protek / cursor
$6B3B ; the 18-byte cursor fire test
$6B4D b ControlGap 15 ; Zeros between the menu (end of block 5) and the template (block 4)
@res leftovers/control-gap.bin

@module vars ; The actor pages, the globals, the buffers
@about One actor is one 256-byte page: the record is +$00..+$41; +$82..+$FF of the ten pages $5D00-$6600 hold the page tails (PageTailTemplate), the gap between is the spare rest. The room is six planes of 256 cells ($6700-$6CFF, cell = row x 20 + column, 220 cells; cells $EC-$FF a copy of the row above); the cells $DC-$EB of each plane hold the room's variables (the @var labels in the image).
$6B5C b PageTailTemplate 4 ; The page tails: ten rows of 126 bytes copied to +$82..+$FF of the pages $5D00-$6600; row 0 starts with the score table
> BuildPageTails `$5D07` copies row n to page `$5D` + n. The rows hold the actor kind templates (18 bytes each, pointed at by KindTemplates `$7200`), the size classes (`$6082`), the touch zones (`$5FAC`), the item records, and three pieces of code: SetTune/HavokRoomEnter/HavokRoomLeave (row 2, to `$5FC0`), TitleWhiteRows (row 8, to `$65EE`), and PauseGame, PendingMessage, RunBanner, ShowMessage (row 9, to `$6682-$66F6`), with TitleColours (`$66FA`).
> The bytes `$6F00-$7047` are copied first, then BuildPageTails overwrites them with the tables OutlineMask, RowBase and NameBoxPlaces.
> The template is cut into its tables, each a resource (src/res/tables/README.md), and the three pieces of code, kept as data rows. The first, here: the score records, 20 x 4 bytes (run time `$5D82` + 4 n): the score sprite and three BCD bytes of points (AddScore `$99E7`, tables/score-table.csv).
@res tables/score-table.bin
$6BAC b ItemRecords 4 ; The pickup kinds' records (row 0 from run time $5DD2, row 1 from $5E82): frame, score record, two bytes
> KindTemplates `$7200` points the pickup kinds (below `$23`) here; CollectPickup `$98B6` and SetWeapon `$98F3` read them (tables/items.csv). `$6BD8-$6BD9` is spare.
$6BDA PageTail5E ; row 1: to $5E82-$5EFF
@res tables/items.bin
$6C36 b WalkLists ; Walk frame lists (run time $5EDE): [n] then n frames, an actor's +$05
@res tables/walk-lists.bin
$6C51 b WeaponRecords 7 ; The thrown weapons' records, kinds $40-$46 (run time $5EF9, $5F82-$5FAB): 7 bytes patched into WeaponTemplate
@res tables/weapons.bin
$6C58 PageTail5F ; row 2: to $5F82-$5FFF
$6C82 b TouchZoneRecords 4 ; The touch zones (run time TouchZones $5FAC): five of Y from, Y to, X from, X to, signed
@res tables/touch-zones.bin
$6C96 b SetTuneCode 8 ; Code kept as data: run time $5FC0 SetTune, HavokRoomLeave $5FCB, HavokRoomEnter $5FD4 (57 bytes)
$6CCF ; spare (to $5FFF)
$6CD6 b PageTail60 5 ; Row 3 (to $6082-$60FF): the 24 sprite sets, SizeClasses $6082 at run time: half columns, rows, bytes a frame, address
> SpawnActor `$A65D` copies a set's five bytes to the actor's `+$15-+$19` (tables/sprite-sets.csv).
@res tables/sprite-sets.bin
$6D4E b SpriteSetsTail 6 ; The last six bytes of row 3 (run time $60FA-$60FF): $18 $40 and four zeros, after the 24 sets
$6D54 b PageTail61 18 ; Rows 4-8 (to $6182-$65FF): 34 actor templates of 18 bytes, copied to an actor's +$03..+$14 by SpawnActor
> KindTemplates `$7200` names the kinds of each (tables/actor-templates.csv); the run-time names WeaponTemplate, SharedEnemyTemplate, HiroTemplate and TitlePieceTemplate lie here.
$6DD2 PageTail62 ; row 5: to $6282-$62FF
$6E50 PageTail63 ; row 6: to $6382-$63FF
$6ECE PageTail64 ; row 7: to $6482-$64FF
$6F4C PageTail65 ; row 8: to $6582-$65FF
@res tables/actor-templates.bin
$6FB8 b TitleWhiteRowsCode 8 ; Code kept as data: run time $65EE: EXX; fill $59E0-$5ADF with $47; EXX; RET
$6FC8 ; spare
$6FCA b PageTail66 8 ; Row 9, code kept as data: run time PauseGame $6682, PendingMessage $66B6, RunBanner $66BD, ShowMessage $66C8
$703F b CellColoursTemplate 9 ; The end of row 9 (run time $66F7-$66FF): the cell colours by plane nibble, the last six TitleColours
> The render's `$88BA` takes a revealed cell's attribute from CellColours `$66F7` by the high nibble of its plane `$6C` byte; TitleSequence `$A754` reads the last six (tables/cell-colours.csv).
@res tables/cell-colours.bin

@module rooms ; The map lookup, the room decoder and builder, the room objects and zones
$7048 b MapColumns 16 ; The map's columns: 127 column numbers, read through MapRowCounts / MapRowStarts
> Read by the map lookup `$95F9` with MapRowCounts `$70C7` and MapRowStarts `$70DB`: row r's rooms are MapColumns[start r .. start r + count r - 1]; the room number is the place in the list + 1.
@res rooms/map.bin
$70C7 b MapRowCounts 20 ; The rooms in each of the map's 20 rows
@res rooms/map.bin
$70DB b MapRowStarts 20 ; Each map row's first index in MapColumns
@res rooms/map.bin
$70EF c ClearRoomCells ; Clear B cells from C in the six room planes $6700-$6C00
> A = 0, L = C; for each cell the six planes `$67`-`$6C`. From BuildPageTails (`$DC`, `$24` cells: the spare cells and the row above), and the room build `$9F3D` (C = `$EC`, B = `$14`: the row above) and `$9F6A` (C = 0, B = `$DC`: the whole room).
> Witness: L1 424 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x2, opt x3, poke-room x15, rzx x56, rzxroom x19).
$70F1 ClearRoomCellsLoop
$7102 w RoomDataPointers 8 ; The room data's address for each room 1-127 ($A928-$D0A5)
> Read by `$A3C9` (H = `$71`, L = room x 2: room 1 is `$7102`). MENU names the table's base `$7100` RoomDataTable; its first word `$7100` (room 0) lies in ClearRoomCells.
$7200 b KindTemplates 2 ; The actor kinds' templates: 73 words, kind -> template (0 for no kind)
> Read by KindTemplate `$A652` (kind AND `$7F`, DE = the word). The templates lie in the page tails (`$5D82` ... `$66FF`, from PageTailTemplate). Bytes, not words: the words point at run-time addresses whose image bytes are other things.
@res tables/kind-templates.bin
$7292 b SolidTiles 2 ; Room tile tables: pairs (plane page, tile) read by $A334
> Read by `$A334` (B pairs from HL): entry points SolidTiles `$7292`, `$7294` and LedgeTiles `$72B4`.
$72B4 LedgeTiles
@res rooms/solid-tiles.bin
$72D8 b TopTiles 2 ; Three pairs (plane page, tile) read by $A298
@res rooms/solid-tiles.bin
$72DE c RoomPatch ; Room opcode handler: fix-ups for rooms 1 and 8 in the cell property plane $6C00
> Reached through the room opcode table (`$73C7`, `JP (HL)` at `$A015`). Room 1: the ten cells `$78-$81` of `$6C00` get the property `$20`; room 8: the cells `$5A`, `$5B`, `$6E`, `$6F` get 0. Other rooms: nothing.
> Witness: L1 206 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x1, opt x3, poke-room x15, rzx x56, rzxroom x18).
$72EA RoomPatchLoop
$72F1 RoomPatch8

@module panel ; Energy, lives, score and the panel
@about The panel code lies over the tape loader's page ($FF00-$FFFF, copied by the bootstrap from $5093). The main loop calls PanelWeapon $FF01 and PanelMeters $FF64 on every pass: each value is compared with its shown copy, and only a change is drawn.
$FF01 c PanelWeapon ; The weapon bar and the fragment count, when they change
> WeaponCount `$6649` against WeaponCountShown: on a change it is stored; at 0 the default weapon comes back (`$98F3` with HL = WeaponDefaultItem `$5DF8`). The bar: 16 bytes at `$7F0D` (the pixel rows of glyphs `$85`/`$86`): 16 - count rows cleared, then count rows of `$0E` (count >= 9) or `$E0`, shifted one place on odd rows; StatusLine printed (`$836B`). The status line is printed tall at the aligned Y `$B8`, so row 7 of glyphs `$85`/`$86` is never drawn: units 1 and 9 of the bar are invisible (doc 08, 8.8).
> Witness: L1 2036417 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x1, opt x3, poke-room x15, rzx x71, rzxroom x18).
$FF14 PanelWeaponBar
$FF1D PanelWeaponClear
$FF23 PanelWeaponFill
$FF27 PanelWeaponRow
$FF30 PanelWeaponShift
$FF35 PanelWeaponStore
$FF39 PanelWeaponPrint
$FF3C PanelFragments ; Fragments $664E against FragmentsShown: sound 5, the count's 6 glyph codes from $7F17 + 6n, print $82D5
$FF55 PanelFragmentsIndex
$FF64 c PanelMeters ; The charge and energy meters, when they change
> Charge `$6645` / ChargeShown to the meter at `$51F8`, Vitality `$6642` / VitalityShown to `$51E0`, each through DrawMeter.
> Witness: L1 2036423 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x2, opt x3, poke-room x15, rzx x71, rzxroom x18).
$FF72 PanelMetersEnergy
$FF7C c DrawMeter ; Draw a meter of value A (0-$20) at the screen DE: 8 bytes x 6 pixel rows from MeterStrip
> Stores A at (HL), the shown copy. MeterPartial `$FFC2` = `$FF`; C = `$BB` (full, `$20`), `$C3` (empty, 0), or `$C2` - A / 4 with MeterPartial = MeterGradient[A AND 3]. The 8 bytes from `$FF00` + C are a window on MeterStrip: full bytes, the partial one, empty ones. Six rows (D + 1 a row).
> The entries `$FF90`, `$FF94`, `$FFB2` are split off because the tape loader's LD-EDGE routines and its end lie at these addresses while it runs.
> Witness: L1 10240 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x1, opt x3, poke-room x15, rzx x70, rzxroom x15).
$FF90 c DrawMeterPartial ; MeterGradient[A AND 3]
> Witness: L1 784281 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x2, opt x3, rzx x70, rzxroom x15).
$FF94 c DrawMeterGradient ; MeterPartial = the gradient byte; C = $C2 - A / 4
> Witness: L1 1567338 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x2, opt x3, rzx x70, rzxroom x15).
$FFA3 DrawMeterWindow
$FFA8 DrawMeterRow
$FFB2 c DrawMeterNext ; The next pixel row
> Witness: L1 61447 (bossgate, deaths, gameover, havok, hiscore, menu, play48, rooms, throw, c x2, opt x3, poke-room x15, rzx x70, rzxroom x15).
$FFB7 b MeterGradient 4 ; A meter's partial byte for A AND 3 = 0-3 ($55, $D5, $F5, $FD)
$FFBB MeterStrip ; 7 full bytes, MeterPartial, 8 empty bytes ($55)
$FFC2 MeterPartial
$FFC3 MeterEmpty
@res graphics/panel-meter.bin
$FFCB b PanelAttrs 8 ; The panel's attribute row (32 bytes) at $5AE0: the meters, EXTRA, the weapon bar, BONUS
@res graphics/panel-attrs.bin
$FFEB c PanelAttrsRoom ; Panel attributes to $5AE0; $88AE = Room; Z when in room 4
> Called by NewGame `$5CE7` (and the room change). The Z result picks the play window's colour (`$46` in room 4, the start room, else 7).
> Witness: L1 14 (deaths, gameover, havok, hiscore, menu, play48, throw, c x1, opt x3, rzx x1, rzxroom x1).
$FFFE PanelAttrsRoomEnd ; also the target of GlyphBytesAsCode's JP PE (bytes read as code)
$FFFF b PanelEnd ; The byte after the panel code (0 in the image): not part of the bootstrap's copy ($FF01-$FFFE), no reader found
@res leftovers/panel-end.bin
# Region IRQ: $72FE-$8A2F. The data block $72FE-$8319 (room-build tables, variables, the title scene, the gates,
# the actor scripts, the font, the Fireblade icons, the end picture, the high-score and end texts) and the code
# $831A-$8A2F (waits, screen clears, the print routines, the IM 2 handler and its tick, the input read, the 48K
# effect player and its table, the end picture, the cell composer). Findings: IRQ.md.



@module leftovers ; Bytes no code reads
$72FE b Leftover72FE ; Two zero bytes between the code at $72DE and the room tables, read by no recording
> No keyed recording reads or writes $72FE-$72FF (work/stage1 L1 profiles).
