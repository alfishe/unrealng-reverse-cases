$C871 ; A = k
$C872 ; 2k
$C873 ; 4k: four facings a part
$C874 ; the second facing
$C875 ; PartSpriteTable + 4k + 1
$C878 ; HL = the entry
$C87C ; 2 x the number
$C87D ; + 1: its second graphic
$C87E ; the part sprites' pointers (sprite id $16 on)
$C881 ; HL = that graphic
$C885 ; to the width byte
$C886 ; B = the bytes a line
$C887 ; HL = the first line
$C889 ; 2 bytes (mask, pixels) a byte of width
$C88A ; HL = the second line
$C88E ; the lines left
$C88F ; more than 24?
$C891 ; fits
$C893 ; cut to 24 lines, the part's 3 character rows
$C898 ; DE = the bottom line of this part's place
$C899 ; B = the parts left
$C89B ; the low byte - 3 x 32
$C89D ; E = it
$C89E ; no borrow: the same third of the screen
$C8A0 ; a borrow: the third above
$C8A1 ; D - 8: one screen third up
$C8A3 ; D = it
$C8A9 ; the attribute of row 15, column 0
$C8AF ; the next cell
$C8B0 ; four cells
$C8B4 ; HL = the next row's column 0
$C8B7 ; C = the rows left
