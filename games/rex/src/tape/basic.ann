$5D0A ; PRINT ($F5) AT ($AC) "0", $0E and 0, "," "0", $0E and 0, ";", ENTER
$5D1D b BasicLine50 ; Line 50: LOAD "" CODE
> Loads the code block at the start its header gives ($61A8).
$5D26 b BasicLine60 ; Line 60: RANDOMIZE USR 35460
> Calls DEMO's entry $8A84 (src/demo), which never returns.
$5D2A ; RANDOMIZE ($F9) USR ($C0) "35460", $0E and 35460 = $8A84, ENTER
$5D38 b BasicLine999 ; Line 999: SAVE "t:": SAVE "DEMO" LINE 1: LOAD "a:": LOAD "maked"
> The authors' mastering line, never run (the program starts at line 1, and line 60 does not return). SAVE "t:" sends the next SAVE to the tape and LOAD "a:" makes a disk drive the default, the syntax of a disk interface's BASIC: so the program saves itself to tape with LINE 1 and then loads the next step, "maked", from the disk (known only from the BASIC's text).
$5D3C ; SAVE ($F8) "t:" ":"
