$8080 b RenderVars ; The renderer's and the controls' variables
> In the image $8080-$80B2 hold "UND|" (the end of TrailsTextLeftover's "REGROUND|") and an older copy of KeyChars with c, e and s for CAPS SHIFT, ENTER and SYMBOL SHIFT: SetupIm2 writes the vector, ClearKeys the key states before any read.
$8080 Im2Jump ; JP Interrupt: every byte of the IM 2 table ($FE00-$FF00) is $80, so the vector is $8080 (SetupIm2 writes the JP)
$8084 AttrBase ; the attribute area the attribute routines write ($5800, $5821 for the top half, $59A1 for the bottom)
$8086 KempstonOn ; 1: player 1 uses the Kempston joystick
$8087 Keyboard1Alt ; nonzero: player 1's keys are the Sinclair keys 6-0 in a two-player game (no menu item sets it; ChooseKeys1)
$8088 SinclairOn ; 0: player 2 uses the keyboard, 1 the Sinclair joystick (keys 6-0)
$8089 JoyBits ; the Kempston's five bits ORed in by ScanKeys
$808A FillByte ; FillAttrs's attribute byte
$808B KeyStates ; 40 bytes, 1 for a key held: the eight half-rows from CAPS SHIFT-V to SPACE-B, five keys each, bit 0 first
$80B3 KeyChars ; the 40 keys' characters for the menus ("_" a key that cannot be chosen: CAPS SHIFT, ENTER, SYMBOL SHIFT, SPACE)
$80DB SpriteX ; x in pixels (a word for the trail lists: the item's distance minus the scroll)
$80DD SpriteY ; y, counted up from the bottom line
$80DF ScreenBase ; the screen's base address for ScreenAddr ($4000, or $4021 / $48A1 in play)
$80E5 DestAddr ; the buffer or screen address a draw mode writes
$80E7 SpriteNum ; the sprite number
$80E8 SpriteData ; the sprite's bytes
$80EA MaskData ; a mask sprite's bytes (the masked modes)
$80F2 SpriteWidth ; width in bytes
$80F3 SpriteHeight ; height in lines
$80F4 ShiftPtr ; the address of the sprite's shift byte (header +3)
$80F6 SpriteAdvance ; the sprite's advance (header +2)
$80F7 AttrDest ; the attribute modes' destination
$80F9 AttrSrc ; a picture's attributes
$80FB AttrWidth
$80FC AttrHeight
$80FF LineCount ; ShiftBytesRight / ShiftBytesLeft's line counter
$8100 ShiftCount ; ShiftLeftBy / ShiftRightBy's bit counter
$8109 KeyIndexes1 ; player 1's five keys (KeyStates indexes: left, right, up, down, jump): S, D, F, C, Z
$810E KeyIndexes2 ; player 2's: H, J, K, M, B
$8113 Controls1 ; player 1's control bits this pass: 4 left, 3 right, 2 up, 1 down, 0 jump
$8114 Controls2 ; player 2's
$8115 ClipWidth ; the bytes drawn of a clipped sprite
$8118 ClipSkip ; the bytes skipped of a clipped sprite's lines
$811A ClipCode ; PlaceItem's verdict: 0 inside, 1 beyond the right edge, 2 before the left edge, 3 cut at the right, 4 cut at the left
$811B ListBase ; the trail list being walked
$811D ListIndexPtr ; the address of the list's index word (DistanceIndex / ScenIndex)
$811F ListScroll ; the list's scroll (the distance)
$8121 ItemFlags ; the item's draw flags: bit 0 attributes too, bits 1-4 the mask's offset, bit 5 defer to DeferredB, bit 6 defer to DeferredA, bit 7 masked
$8122 PlayerIndex ; 0 player 1, 1 player 2: whose pass this is
$8123 SeenCount ; the animated objects stepped this pass (AnimObject; at most 30)
$8124 SeenIds ; their ids: an object seen twice in a pass (both players) moves once
$8142 SavedSp ; SP while ClearBuffer pushes zeros
$8144 BufferBase ; the buffer being drawn ($F03C or $F71C)
$8146 DeferredA ; deferred sprites drawn before the ATV: the next free offset, $8148 the count, $8149 items of 8 bytes (x, y, advance, sprite, routine, clip code, flags)
$81E9 DeferredB ; deferred sprites drawn after the ATV: offset, count ($81EB), items from $81EC
$828C DeferredAttrs ; deferred attribute copies: offset, count ($828E), items of 7 bytes from $828F
$82F8 ModeVector ; the draw mode word in use (DrawModes or ListModes)
$82FA AttrModeVector ; the attribute mode word in use
